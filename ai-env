cmd_inventory() {
  local filter="${1:-}"

  if [[ ! -d "$SKILL_STORE" ]]; then
    die "Canonical store not found. Run ${CYAN}ai-env init${RESET} first."
  fi

  echo -e "${BOLD}Skill Inventory${RESET} (${DIM}${SKILL_STORE}${RESET})\n"

  # Build inventory using python for clean sorting/grouping
  python3 -c "
import os
from pathlib import Path
from collections import defaultdict

store = Path(os.path.expanduser('$SKILL_STORE'))
sources_file = os.path.expanduser('$SOURCES_FILE')

# Build source mapping: marketplace/plugin -> source_name
source_map = {}  # partial path -> source name
if os.path.exists(sources_file):
    current = {}
    in_sources = False
    for line in open(sources_file):
        line = line.rstrip()
        if line.startswith('sources:'):
            in_sources = True
            continue
        if not in_sources:
            continue
        if line.startswith('  - '):
            if current.get('name') and current.get('marketplace') and current.get('plugin'):
                key = f\"{current['marketplace']}/{current['plugin']}\"
                source_map[key] = current['name']
            current = {}
            rest = line[4:].strip()
            if rest.startswith('name:'):
                current['name'] = rest.split(':',1)[1].strip().strip('\"').strip(\"'\")
        elif line.startswith('    ') and ':' in line:
            k, v = line.strip().split(':', 1)
            current[k.strip()] = v.strip().strip('\"').strip(\"'\")
    if current.get('name') and current.get('marketplace') and current.get('plugin'):
        source_map[f\"{current['marketplace']}/{current['plugin']}\"] = current['name']

def get_prefix(item):
    \"\"\"Determine skill prefix from symlink target or dirname.\"\"\"
    if item.is_symlink():
        target = str(item.resolve())
        # Match against registered sources
        for path_key, src_name in source_map.items():
            if path_key in target:
                return src_name, item.name
        # Fallback: unknown plugin
        return 'plugin', item.name
    else:
        # Local skill: use first segment before dash, or 'local'
        name = item.name
        if '-' in name:
            return name.split('-', 1)[0], name.split('-', 1)[1]
        return 'local', name

skills = []
for item in sorted(store.iterdir()):
    if not item.is_dir():
        continue
    prefix, remainder = get_prefix(item)
    source_type = 'symlink' if item.is_symlink() else 'local'
    skills.append((prefix, remainder, item.name, source_type))

# Group by prefix
groups = defaultdict(list)
for prefix, remainder, dirname, stype in skills:
    groups[prefix].append((remainder, dirname, stype))

filter_pattern = '$filter'

for prefix in sorted(groups.keys()):
    items = groups[prefix]
    print(f'  \033[1m{prefix}\033[0m ({len(items)} skills)')
    for remainder, dirname, stype in items:
        skill_id = f'{prefix}:{remainder}'
        if filter_pattern and filter_pattern not in skill_id:
            continue
        marker = '  \033[2m(plugin)\033[0m' if stype == 'symlink' else ''
        print(f'    {skill_id}{marker}')
    print()

total = len(skills)
print(f'Total: {total} skills')
"
}

