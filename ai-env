cmd_reset() {
  local force=false
  [[ "${1:-}" == "-f" || "${1:-}" == "--force" ]] && force=true

  echo -e "${BOLD}ai-env reset${RESET} — restore to clean state\n"

  # 1. Inventory what will be removed
  local symlink_count_claude=0 symlink_count_agents=0 store_count=0
  if [[ -d "$CLAUDE_SKILLS" ]]; then
    symlink_count_claude=$(find "$CLAUDE_SKILLS" -maxdepth 1 -type l 2>/dev/null | wc -l | tr -d ' ')
  fi
  if [[ -d "$AGENT_SKILLS" ]]; then
    symlink_count_agents=$(find "$AGENT_SKILLS" -maxdepth 1 -type l 2>/dev/null | wc -l | tr -d ' ')
  fi
  if [[ -d "$SKILL_STORE" ]]; then
    store_count=$(find "$SKILL_STORE" -maxdepth 1 -mindepth 1 2>/dev/null | wc -l | tr -d ' ')
  fi

  # 2. Scan store symlinks to find which plugins are managed by ai-env
  local settings_file="$HOME/.claude/settings.json"
  local managed_plugins=""
  if [[ -d "$SKILL_STORE" ]]; then
    managed_plugins=$(python3 -c "
import os, re
from pathlib import Path

store = Path(os.path.expanduser('$SKILL_STORE'))
# Extract unique marketplace/plugin pairs from symlink targets
# Symlinks point to: ~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/...
pattern = re.compile(r'/\.claude/plugins/cache/([^/]+)/([^/]+)/')
seen = set()
for item in sorted(store.iterdir()):
    if item.is_symlink():
        target = str(item.resolve())
        m = pattern.search(target)
        if m:
            marketplace, plugin = m.group(1), m.group(2)
            key = f'{plugin}@{marketplace}'
            if key not in seen:
                seen.add(key)
                print(key)
" 2>/dev/null || true)
  fi

  # Cross-reference with disabled plugins in settings.json
  local plugins_to_enable=""
  if [[ -n "$managed_plugins" && -f "$settings_file" ]]; then
    plugins_to_enable=$(python3 -c "
import json, sys

managed = set(line.strip() for line in '''$managed_plugins'''.strip().splitlines() if line.strip())

with open('$settings_file') as f:
    data = json.load(f)
plugins = data.get('enabledPlugins', {})
for key, val in plugins.items():
    if not val and key in managed:
        print(key)
" 2>/dev/null || true)
  fi
  local enable_count
  enable_count=$(echo "$plugins_to_enable" | grep -c . 2>/dev/null || echo 0)

  # 3. Show summary
  echo -e "${BOLD}Will remove:${RESET}"
  echo -e "  ${symlink_count_claude} managed symlink(s) in ~/.claude/skills/"
  echo -e "  ${symlink_count_agents} managed symlink(s) in ~/.agents/skills/"
  echo -e "  ${store_count} item(s) in skill store (~/.config/ai-env/skills/)"
  echo -e "  State files (.active, .last-scan)"
  echo -e "  Project-local skill symlinks (for all environments with directory: set)"
  echo ""
  echo -e "${BOLD}Will re-enable (plugins with skills in store):${RESET}"
  if [[ "$enable_count" -gt 0 ]]; then
    echo "$plugins_to_enable" | while IFS= read -r p; do
      [[ -n "$p" ]] && echo -e "  ${CYAN}${p}${RESET}"
    done
  else
    echo -e "  ${DIM}(no managed plugins to re-enable)${RESET}"
  fi
  echo ""
  echo -e "${BOLD}Will keep:${RESET}"
  echo -e "  Environment configs (~/.config/ai-env/environments/)"
  echo -e "  Source registry (~/.config/ai-env/sources.yaml)"
  echo ""

  # 4. Confirm unless --force
  if [[ "$force" != true ]]; then
    echo -n "Proceed? [y/N] "
    read -r confirm
    [[ "$confirm" != "y" && "$confirm" != "Y" ]] && { echo "Aborted."; return 0; }
    echo ""
  fi

  # 5. Remove managed symlinks from agent skill dirs
  if [[ -d "$CLAUDE_SKILLS" ]]; then
    find "$CLAUDE_SKILLS" -maxdepth 1 -type l -delete 2>/dev/null
    info "Cleaned ~/.claude/skills/ symlinks"
  fi
  if [[ -d "$AGENT_SKILLS" ]]; then
    find "$AGENT_SKILLS" -maxdepth 1 -type l -delete 2>/dev/null
    info "Cleaned ~/.agents/skills/ symlinks"
  fi

  # 5b. Clean project-local skill dirs for all known environments
  local project_cleaned=0
  for env_yaml in "$ENV_DIR"/*.yaml; do
    [[ ! -f "$env_yaml" ]] && continue
    local env_dir
    env_dir=$(yaml_get "$env_yaml" "directory")
    [[ -z "$env_dir" ]] && continue
    env_dir="${env_dir/#\~/$HOME}"
    for subdir in ".claude/skills" ".agents/skills"; do
      local pdir="$env_dir/$subdir"
      if [[ -d "$pdir" ]]; then
        for item in "$pdir"/*; do
          [[ -L "$item" ]] && rm "$item" && (( project_cleaned++ )) || true
        done
      fi
    done
    # Remove fingerprint
    rm -f "$env_dir/.claude/.ai-env-fingerprint"
  done
  if [[ $project_cleaned -gt 0 ]]; then
    info "Cleaned ${project_cleaned} project-local symlink(s)"
  fi

  # 6. Remove skill store
  if [[ -d "$SKILL_STORE" ]]; then
    rm -rf "$SKILL_STORE"
    info "Removed skill store"
  fi

  # 7. Remove state files
  rm -f "$ACTIVE_FILE" "$CONFIG_DIR/.last-scan"
  info "Removed state files"

  # 8. Re-enable plugins that had skills in the store
  if [[ "$enable_count" -gt 0 && -f "$settings_file" ]]; then
    local enabled_count
    enabled_count=$(python3 -c "
import json, sys

to_enable = set(line.strip() for line in '''$plugins_to_enable'''.strip().splitlines() if line.strip())

with open('$settings_file') as f:
    data = json.load(f)
plugins = data.get('enabledPlugins', {})
count = 0
for key in list(plugins.keys()):
    if key in to_enable and not plugins[key]:
        plugins[key] = True
        count += 1
if count > 0:
    with open('$settings_file', 'w') as f:
        json.dump(data, f, indent=2)
        f.write('\n')
print(count)
")
    info "Re-enabled ${enabled_count} plugin(s) in settings.json"
  fi

  echo ""
  success "Reset complete. To rebuild, run: ${CYAN}ai-env scan && ai-env activate <env>${RESET}"
}

cmd_clone() {
  local src="${1:-}" dest="${2:-}"
  [[ -z "$src" || -z "$dest" ]] && die "Usage: ai-env clone <source> <destination>"

  env_exists "$src" || die "Source environment '${src}' not found."
  env_exists "$dest" && die "Destination environment '${dest}' already exists."

  local src_file dest_file
  src_file="$(env_file "$src")"
  dest_file="$(env_file "$dest")"

  cp "$src_file" "$dest_file"
  success "Cloned: ${src} -> ${dest}"
  info "Edit with: ${CYAN}ai-env edit ${dest}${RESET}"
}

cmd_delete() {
  local name="${1:-}"
  [[ -z "$name" ]] && die "Usage: ai-env delete <name>"
  env_exists "$name" || die "Environment '${name}' not found."

  local active
  active=$(get_active)

  read -rp "Are you sure you want to delete '${name}'? [y/N] " -n 1 confirm
  echo ""
  [[ "$confirm" != "y" && "$confirm" != "Y" ]] && return

  local file
  file="$(env_file "$name")"
  rm "$file"

  # Clear active if it was the deleted environment
  if [[ "$active" == "$name" ]]; then
    rm -f "$ACTIVE_FILE"
    warn "Cleared active environment marker"
  fi

  success "Deleted: ${name}"
}

cmd_which() {
  local active
  active=$(get_active)

  if [[ -z "$active" ]]; then
    warn "No active environment."
    info "Run ${CYAN}ai-env activate <name>${RESET} to set one."
    return
  fi

  echo "$active"
}

# ---------------------------------------------------------------------------
# Export
# ---------------------------------------------------------------------------

_export_to_dir() {
  local target="$1" resolve_output="$2" clean="$3" dry_run="$4" skill_count="$5"
  local exported=0 removed=0

  if [[ "$clean" == true && -d "$target" ]]; then
    local matched_names
    matched_names=$(echo "$resolve_output" | cut -f1)
    for existing in "$target"/*/; do
      [[ ! -d "$existing" ]] && continue
      local dir_name
      dir_name=$(basename "$existing")
      if ! echo "$matched_names" | grep -qx "$dir_name"; then
        if [[ "$dry_run" == true ]]; then
          echo -e "  ${RED}remove${RESET} ${dir_name}/"
        else
          rm -rf "$existing"
        fi
        (( removed++ )) || true
      fi
    done
  fi

  while IFS=$'\t' read -r skill_name real_dir; do
    [[ -z "$skill_name" ]] && continue
    local dest="$target/${skill_name}"
    local file_count
    file_count=$(find "$real_dir" -type f 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$dry_run" == true ]]; then
      echo -e "  ${GREEN}copy${RESET}   ${skill_name}/  ${DIM}(${file_count} files) ← ${real_dir}${RESET}"
    else
      mkdir -p "$target"
      rm -rf "$dest"
      cp -a "$real_dir" "$dest"
    fi
    (( exported++ )) || true
  done <<< "$resolve_output"

  if [[ "$dry_run" == true ]]; then
    echo ""
    info "Dry run: would export ${exported} skills, remove ${removed}"
  else
    success "Exported ${exported} skills to ${target}/"
    [[ "$removed" -gt 0 ]] && info "Removed ${removed} stale skills" || true
  fi
}

_export_to_s3() {
  local target="$1" resolve_output="$2" clean="$3" dry_run="$4" skill_count="$5"
  local exported=0 removed=0

  local bucket prefix
  bucket=$(echo "$target" | sed 's|s3://||' | cut -d/ -f1)
  prefix=$(echo "$target" | sed "s|s3://${bucket}/||" | sed 's|/$||')

  local aws_flags=()
  [[ -n "${AWS_PROFILE:-}" ]] && aws_flags+=(--profile "$AWS_PROFILE")
  [[ -n "${AWS_ENDPOINT_URL:-}" ]] && aws_flags+=(--endpoint-url "$AWS_ENDPOINT_URL")

  if [[ "$clean" == true ]]; then
    local matched_names
    matched_names=$(echo "$resolve_output" | cut -f1)
    local existing_skills
    existing_skills=$(aws "${aws_flags[@]}" s3 ls "s3://${bucket}/${prefix}/" 2>/dev/null \
      | awk '/PRE/ {gsub(/\/$/, "", $2); print $2}') || true

    while IFS= read -r existing; do
      [[ -z "$existing" ]] && continue
      if ! echo "$matched_names" | grep -qx "$existing"; then
        if [[ "$dry_run" == true ]]; then
          echo -e "  ${RED}remove${RESET} s3://${bucket}/${prefix}/${existing}/"
        else
          aws "${aws_flags[@]}" s3 rm "s3://${bucket}/${prefix}/${existing}/" --recursive > /dev/null 2>&1
        fi
        (( removed++ )) || true
      fi
    done <<< "$existing_skills"
  fi

  while IFS=$'\t' read -r skill_name real_dir; do
    [[ -z "$skill_name" ]] && continue
    local s3_dest="s3://${bucket}/${prefix}/${skill_name}/"
    local file_count
    file_count=$(find "$real_dir" -type f 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$dry_run" == true ]]; then
      echo -e "  ${GREEN}upload${RESET} ${s3_dest}  ${DIM}(${file_count} files) ← ${real_dir}${RESET}"
    else
      aws "${aws_flags[@]}" s3 cp "$real_dir" "$s3_dest" --recursive > /dev/null 2>&1
    fi
    (( exported++ )) || true
  done <<< "$resolve_output"

  if [[ "$dry_run" == true ]]; then
    echo ""
    info "Dry run: would upload ${exported} skills, remove ${removed}"
  else
    success "Exported ${exported} skills to s3://${bucket}/${prefix}/"
    [[ "$removed" -gt 0 ]] && info "Removed ${removed} stale skills" || true
  fi
}

cmd_export() {
  local name=""
  local target=""
  local dry_run=false
  local clean=false
  local all=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --to)         target="$2"; shift 2 ;;
      --dry-run|-n) dry_run=true; shift ;;
      --clean)      clean=true; shift ;;
      --all)        all=true; shift ;;
      -*) die "Unknown flag: $1" ;;
      *)  name="$1"; shift ;;
    esac
  done

  [[ -z "$target" ]] && die "Usage: ai-env export [<env>|--all] --to <dir-or-s3> [--clean] [--dry-run]"

  if [[ "$all" == false && -z "$name" ]]; then
    die "Specify an environment name or use --all.\nUsage: ai-env export [<env>|--all] --to <target> [--clean] [--dry-run]"
  fi

  if [[ "$all" == false ]]; then
    env_exists "$name" || die "Environment '${name}' not found."
  fi

  # Resolve skills to (dirname \t real_path) pairs
  local env_path=""
  [[ "$all" == false ]] && env_path="$(env_file "$name")"

  local resolve_output
  resolve_output=$(python3 -c "
$PY_PREFIX_HELPER
import fnmatch

store = Path(os.path.expanduser('$SKILL_STORE'))
source_map, repo_map = _build_maps(os.path.expanduser('$SOURCES_FILE'))

use_all = $( [[ "$all" == true ]] && echo "True" || echo "False" )
env_file = '$env_path'

# Read patterns from environment config, or match everything
patterns = ['*:*'] if use_all else []
if not use_all and env_file:
    in_skills = False
    for line in open(env_file):
        line = line.rstrip()
        if line.startswith('skills:'):
            in_skills = True
            continue
        if in_skills and line.startswith('  - '):
            patterns.append(line[4:].strip().strip('\"').strip(\"'\"))
        elif in_skills and line and not line.startswith(' ') and not line.startswith('#'):
            break

if not patterns:
    exit(0)

# Resolve each skill to its real directory path
for item in sorted(store.iterdir()):
    if not item.is_dir() and not item.is_symlink():
        continue
    skill_md = item / 'SKILL.md'
    try:
        real_path = skill_md.resolve()
    except OSError:
        continue
    if not real_path.exists():
        continue
    prefix, remainder = _get_prefix(item, source_map, repo_map)
    skill_id = f'{prefix}:{remainder}'
    if any(fnmatch.fnmatch(skill_id, p) for p in patterns):
        print(f'{item.name}\t{real_path.parent}')
")

  if [[ -z "$resolve_output" ]]; then
    warn "No skills matched."
    return
  fi

  local skill_count
  skill_count=$(echo "$resolve_output" | grep -c . || echo 0)

  # Route to target-specific export
  if [[ "$target" == s3://* ]]; then
    _export_to_s3 "$target" "$resolve_output" "$clean" "$dry_run" "$skill_count"
  else
    _export_to_dir "$target" "$resolve_output" "$clean" "$dry_run" "$skill_count"
  fi
}

