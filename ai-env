#!/usr/bin/env bash
# ============================================================================
# ai-env — Skill Profile Manager for AI Coding Agents
# ============================================================================
# Discovers skills from multiple plugin sources, manages a local store
# at ~/.config/ai-env/skills/, and rebuilds agent skill directories with
# filtered symlinks based on environment configs.
#
# Usage:  ai-env <command> [options]
# Config: ~/.config/ai-env/
# ============================================================================

set -euo pipefail

# ---------------------------------------------------------------------------
# Constants & defaults
# ---------------------------------------------------------------------------
VERSION="3.0.0"
CONFIG_DIR="${AI_ENV_DIR:-$HOME/.config/ai-env}"
ENV_DIR="$CONFIG_DIR/environments"
SOURCES_FILE="$CONFIG_DIR/sources.yaml"
ACTIVE_FILE="$CONFIG_DIR/.active"
SKILL_STORE="$CONFIG_DIR/skills"
REPOS_DIR="$CONFIG_DIR/repos"
CONFIG_FILE="$CONFIG_DIR/config.yaml"
AGENT_SKILLS="$HOME/.agents/skills"
CLAUDE_SKILLS="$HOME/.claude/skills"
EDITOR="${EDITOR:-vim}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
info()    { echo -e "${BLUE}ℹ${RESET}  $*"; }
success() { echo -e "${GREEN}✓${RESET}  $*"; }
warn()    { echo -e "${YELLOW}⚠${RESET}  $*"; }
error()   { echo -e "${RED}✗${RESET}  $*" >&2; }
die()     { error "$@"; exit 1; }

# Check for required dependencies
require_cmd() {
  command -v "$1" &>/dev/null || die "Required command '$1' not found. Please install it."
}

# Read a YAML value using basic parsing (no external deps)
# Supports simple key: value pairs and nested keys via dot notation
yaml_get() {
  local file="$1" key="$2"
  # Handle simple top-level keys
  if [[ "$key" != *.* ]]; then
    grep -E "^${key}:" "$file" 2>/dev/null | head -1 | sed "s/^${key}:[[:space:]]*//" | sed 's/^["'"'"']\(.*\)["'"'"']$/\1/' | sed 's/[[:space:]]*$//' || true
  else
    # Handle nested keys (one level: parent.child)
    local parent="${key%%.*}"
    local child="${key#*.}"
    awk -v parent="$parent" -v child="$child" '
      BEGIN { in_section=0 }
      /^[^ #]/ { in_section=0 }
      $0 ~ "^"parent":" { in_section=1; next }
      in_section && $0 ~ "^[[:space:]]+"child":" {
        sub(/^[[:space:]]+/,"",$0)
        sub(/^[^:]+:[[:space:]]*/,"",$0)
        gsub(/^["'"'"'"'"'"']|["'"'"'"'"'"']$/,"",$0)
        print $0
        exit
      }
    ' "$file"
  fi
}

# Read a YAML list (lines starting with "  - ")
yaml_list() {
  local file="$1" key="$2"
  awk -v key="$key" '
    BEGIN { in_section=0 }
    /^[^ #]/ { if (in_section) exit; in_section=0 }
    $0 ~ "^"key":" { in_section=1; next }
    in_section && /^[[:space:]]+-[[:space:]]/ {
      sub(/^[[:space:]]+-[[:space:]]*/,"",$0)
      gsub(/^["'"'"'"'"'"']|["'"'"'"'"'"']$/,"",$0)
      gsub(/[[:space:]]*$/,"",$0)
      print $0
    }
  ' "$file"
}

# Read a YAML map (key: value pairs under a section)
yaml_map() {
  local file="$1" section="$2"
  awk -v section="$section" '
    BEGIN { in_section=0 }
    /^[^ #]/ { if (in_section) exit; in_section=0 }
    $0 ~ "^"section":" { in_section=1; next }
    in_section && /^[[:space:]]+[^-]/ && /:[[:space:]]/ {
      sub(/^[[:space:]]+/,"",$0)
      print $0
    }
  ' "$file"
}

# Read a deeply nested YAML value (up to 3 levels: a.b.c)
yaml_nested_get() {
  local file="$1" key="$2"
  local -a parts
  IFS='.' read -ra parts <<< "$key"
  local depth=${#parts[@]}

  if [[ $depth -eq 1 ]]; then
    yaml_get "$file" "${parts[0]}"
  elif [[ $depth -eq 2 ]]; then
    yaml_get "$file" "${parts[0]}.${parts[1]}"
  elif [[ $depth -eq 3 ]]; then
    # Three-level nesting: agents.claude.model
    python3 -c "
import sys
lines = open('$file').readlines()
level = 0
found = [False, False, False]
keys = ('${parts[0]}', '${parts[1]}', '${parts[2]}')
for line in lines:
    stripped = line.rstrip()
    if not stripped or stripped.startswith('#'):
        continue
    indent = len(line) - len(line.lstrip())
    content = stripped.lstrip()
    if indent == 0 and content.startswith(keys[0] + ':'):
        found[0] = True
        continue
    if found[0] and indent == 2 and content.startswith(keys[1] + ':'):
        found[1] = True
        continue
    if found[1] and indent == 4 and content.startswith(keys[2] + ':'):
        val = content.split(':', 1)[1].strip().strip('\"').strip(\"'\")
        print(val)
        sys.exit(0)
    if found[1] and indent <= 2:
        break
    if found[0] and indent == 0:
        break
"
  fi
}

env_file() {
  echo "$ENV_DIR/${1}.yaml"
}

env_exists() {
  [[ -f "$(env_file "$1")" ]]
}

list_envs() {
  find "$ENV_DIR" -maxdepth 1 -name '*.yaml' -exec basename {} .yaml \; 2>/dev/null | sort
}

get_active() {
  [[ -f "$ACTIVE_FILE" ]] && cat "$ACTIVE_FILE" || echo ""
}

# Read a value from config.yaml
config_get() {
  local key="$1"
  [[ -f "$CONFIG_FILE" ]] && yaml_get "$CONFIG_FILE" "$key" || echo ""
}

# Walk from a directory up to / looking for .ai-env.yaml
# Prints the path to the first one found, or empty string
find_project_config() {
  local dir="${1:-$PWD}"
  dir="${dir/#\~/$HOME}"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.ai-env.yaml" ]]; then
      echo "$dir/.ai-env.yaml"
      return 0
    fi
    dir=$(dirname "$dir")
  done
  return 1
}

# Resolve environment name from current working directory
# Strategy 1: .ai-env.yaml in cwd or parent (nearest match)
# Strategy 2: match cwd against directory: fields in all environments
# Strategy 3: fall back to default_environment from config.yaml
# Prints: environment name, or exits non-zero
resolve_env_from_cwd() {
  local cwd="${1:-$PWD}"

  # Strategy 1: .ai-env.yaml file
  local project_config
  if project_config=$(find_project_config "$cwd"); then
    local env_ref
    env_ref=$(yaml_get "$project_config" "environment")
    if [[ -n "$env_ref" ]]; then
      if env_exists "$env_ref"; then
        echo "$env_ref"
        return 0
      else
        warn ".ai-env.yaml references unknown environment: ${env_ref}"
      fi
    fi
  fi

  # Strategy 2: match cwd against directory: fields
  local best_match="" best_length=0
  for env_file in "$ENV_DIR"/*.yaml; do
    [[ ! -f "$env_file" ]] && continue
    local env_dir
    env_dir=$(yaml_get "$env_file" "directory")
    [[ -z "$env_dir" ]] && continue
    env_dir="${env_dir/#\~/$HOME}"
    # Normalize: remove trailing slash
    env_dir="${env_dir%/}"
    local check_dir="${cwd%/}"
    # Check if cwd starts with env_dir (is inside or equal)
    if [[ "$check_dir" == "$env_dir" || "$check_dir" == "$env_dir"/* ]]; then
      local dir_length=${#env_dir}
      if [[ $dir_length -gt $best_length ]]; then
        best_length=$dir_length
        best_match=$(basename "$env_file" .yaml)
      fi
    fi
  done

  if [[ -n "$best_match" ]]; then
    echo "$best_match"
    return 0
  fi

  # Strategy 3: default environment
  local default_env
  default_env=$(config_get "default_environment")
  if [[ -n "$default_env" ]] && env_exists "$default_env"; then
    echo "$default_env"
    return 0
  fi

  return 1
}

# ---------------------------------------------------------------------------
# Fingerprint & Reconcile helpers (for incremental symlink updates)
# ---------------------------------------------------------------------------

# Compute a fingerprint for a skill set
# Input: sorted skill directory names (one per line) on stdin
# Output: SHA-256 hash string
compute_fingerprint() {
  local env_name="$1"
  {
    echo "$env_name"
    cat  # stdin: sorted skill names
  } | shasum -a 256 | cut -d' ' -f1
}

# Reconcile symlinks in a skill directory to match expected set
# Args: <target_dir> <expected_skills (newline-separated)> <skill_store_path>
# Returns: added|removed counts via global vars
_RECONCILE_ADDED=0
_RECONCILE_REMOVED=0

reconcile_skill_dir() {
  local target_dir="$1"
  local expected="$2"
  local store="$3"

  mkdir -p "$target_dir"

  _RECONCILE_ADDED=0
  _RECONCILE_REMOVED=0

  # Build expected set
  local -A expected_set
  while IFS= read -r skill; do
    [[ -n "$skill" ]] && expected_set["$skill"]=1
  done <<< "$expected"

  # Remove symlinks not in expected set
  for item in "$target_dir"/*; do
    [[ ! -L "$item" ]] && continue
    local name
    name=$(basename "$item")
    if [[ -z "${expected_set[$name]+_}" ]]; then
      rm "$item"
      (( _RECONCILE_REMOVED++ )) || true
    fi
  done

  # Add missing symlinks
  while IFS= read -r skill; do
    [[ -z "$skill" ]] && continue
    local target_path="$target_dir/${skill}"
    if [[ ! -L "$target_path" ]]; then
      local source_path="$store/${skill}"
      if [[ -d "$source_path" || -L "$source_path" ]]; then
        ln -s "$source_path" "$target_path"
        (( _RECONCILE_ADDED++ )) || true
      fi
    fi
  done <<< "$expected"
}

# ---------------------------------------------------------------------------
# Shared Python: source/repo map builder + get_prefix
# ---------------------------------------------------------------------------
# Emits Python code that builds source_map, repo_map, and defines get_prefix().
# Usage in inline python: exec(open(...)) or paste the output.
# We use a heredoc-safe variable so callers can embed it via $PY_PREFIX_HELPER.

PY_PREFIX_HELPER='
import os
from pathlib import Path

def _build_maps(sources_file):
    source_map = {}
    repo_map = {}
    if not os.path.exists(sources_file):
        return source_map, repo_map
    current = {}
    section = None
    for line in open(sources_file):
        line = line.rstrip()
        if line.startswith("sources:"):
            section = "sources"
            continue
        if line.startswith("repos:"):
            if section == "sources" and current.get("name") and current.get("marketplace") and current.get("plugin"):
                source_map[current["marketplace"] + "/" + current["plugin"]] = current["name"]
            current = {}
            section = "repos"
            continue
        if line.startswith("  - "):
            if section == "sources" and current.get("name") and current.get("marketplace") and current.get("plugin"):
                source_map[current["marketplace"] + "/" + current["plugin"]] = current["name"]
            elif section == "repos" and current.get("name"):
                pfx = current.get("prefix", "")
                rname = pfx if pfx and pfx not in ("false", "true") else current["name"]
                if pfx == "true":
                    rname = current["name"]
                repo_map["repos/" + current["name"]] = rname
            current = {}
            rest = line[4:].strip()
            if rest.startswith("name:"):
                current["name"] = rest.split(":",1)[1].strip().strip("\"").strip("'\''")
        elif line.startswith("    ") and ":" in line:
            k, v = line.strip().split(":", 1)
            current[k.strip()] = v.strip().strip("\"").strip("'\''")
        elif line and not line.startswith(" ") and not line.startswith("#"):
            if section == "sources" and current.get("name") and current.get("marketplace") and current.get("plugin"):
                source_map[current["marketplace"] + "/" + current["plugin"]] = current["name"]
            elif section == "repos" and current.get("name"):
                pfx = current.get("prefix", "")
                rname = pfx if pfx and pfx not in ("false", "true") else current["name"]
                if pfx == "true":
                    rname = current["name"]
                repo_map["repos/" + current["name"]] = rname
            current = {}
            section = None
    if section == "sources" and current.get("name") and current.get("marketplace") and current.get("plugin"):
        source_map[current["marketplace"] + "/" + current["plugin"]] = current["name"]
    elif section == "repos" and current.get("name"):
        pfx = current.get("prefix", "")
        rname = pfx if pfx and pfx not in ("false", "true") else current["name"]
        if pfx == "true":
            rname = current["name"]
        repo_map["repos/" + current["name"]] = rname
    return source_map, repo_map

def _get_prefix(item, source_map, repo_map):
    if item.is_symlink():
        target = str(item.resolve())
        for path_key, src_name in source_map.items():
            if path_key in target:
                return src_name, item.name
        for path_key, rname in repo_map.items():
            if path_key in target:
                return rname, item.name
        return "plugin", item.name
    else:
        name = item.name
        if "-" in name:
            return name.split("-", 1)[0], name.split("-", 1)[1]
        return "local", name
'

# ---------------------------------------------------------------------------
# Plugin Version Resolution
# ---------------------------------------------------------------------------

# resolve_latest_version <cache_path>
# Prints the path to the latest version directory
resolve_latest_version() {
  local cache_path="$1"
  [[ ! -d "$cache_path" ]] && return 1

  python3 -c "
import os, re, sys
from pathlib import Path

cache = Path('$cache_path')
versions = [d for d in cache.iterdir() if d.is_dir()]
if not versions:
    sys.exit(1)

# Check if versions look like semver
semver_re = re.compile(r'^\d+\.\d+\.\d+$')
semver_versions = [v for v in versions if semver_re.match(v.name)]

if semver_versions:
    # Sort by semver (major, minor, patch)
    def semver_key(v):
        parts = v.name.split('.')
        return tuple(int(p) for p in parts)
    latest = max(semver_versions, key=semver_key)
else:
    # Hash-based: use modification time
    latest = max(versions, key=lambda v: v.stat().st_mtime)

print(latest)
"
}

# find_skills_in_version <version_dir>
# Prints skill directory paths, one per line
find_skills_in_version() {
  local version_dir="$1"

  # Check skills/ first (primary location)
  if [[ -d "${version_dir}/skills" ]]; then
    for skill_dir in "${version_dir}/skills"/*/; do
      [[ -d "$skill_dir" ]] && echo "$skill_dir"
    done
  fi

  # Also check .claude/skills/ (some plugins put skills here)
  if [[ -d "${version_dir}/.claude/skills" ]]; then
    for skill_dir in "${version_dir}/.claude/skills"/*/; do
      [[ -d "$skill_dir" ]] && echo "$skill_dir"
    done
  fi
}

# ---------------------------------------------------------------------------
# Source Management
# ---------------------------------------------------------------------------

# parse_sources - reads sources.yaml and outputs name|marketplace|plugin lines
parse_sources() {
  [[ ! -f "$SOURCES_FILE" ]] && return
  python3 -c "
in_sources = False
current = {}
for line in open('$SOURCES_FILE'):
    line = line.rstrip()
    if line.startswith('sources:'):
        in_sources = True
        continue
    if not in_sources:
        continue
    if line.startswith('  - '):
        if current.get('name'):
            print(f\"{current['name']}|{current.get('marketplace','')}|{current.get('plugin','')}\")
        current = {}
        rest = line[4:].strip()
        if rest.startswith('name:'):
            current['name'] = rest.split(':',1)[1].strip().strip('\"').strip(\"'\")
    elif line.startswith('    ') and ':' in line:
        k, v = line.strip().split(':', 1)
        current[k.strip()] = v.strip().strip('\"').strip(\"'\")
    elif line and not line.startswith(' ') and not line.startswith('#'):
        break
if current.get('name'):
    print(f\"{current['name']}|{current.get('marketplace','')}|{current.get('plugin','')}\")
"
}

cmd_source() {
  local subcmd="${1:-}"
  shift || true
  case "$subcmd" in
    list|ls)   cmd_source_list "$@" ;;
    add)       cmd_source_add "$@" ;;
    remove|rm) cmd_source_remove "$@" ;;
    "")        die "Usage: ai-env source <list|add|remove>" ;;
    *)         die "Unknown source command: $subcmd" ;;
  esac
}

cmd_source_list() {
  if [[ ! -f "$SOURCES_FILE" ]]; then
    warn "No sources registered. Run ${CYAN}ai-env init${RESET} or ${CYAN}ai-env source add${RESET}."
    return
  fi
  echo -e "${BOLD}Registered plugin sources:${RESET}\n"
  echo -e "  ${DIM}(~/.config/ai-env/skills/ is always scanned implicitly)${RESET}\n"

  # Parse sources from YAML
  python3 -c "
import sys
in_sources = False
current = {}
for line in open('$SOURCES_FILE'):
    line = line.rstrip()
    if line.startswith('sources:'):
        in_sources = True
        continue
    if in_sources and line.startswith('  - '):
        if current:
            print(f\"  {current.get('name','?'):20s} {current.get('marketplace','?')}/{current.get('plugin','?')}\")
        current = {}
        rest = line[4:].strip()
        if rest.startswith('name:'):
            current['name'] = rest.split(':',1)[1].strip().strip('\"').strip(\"'\")
    elif in_sources and line.startswith('    '):
        parts = line.strip().split(':', 1)
        if len(parts) == 2:
            k = parts[0].strip()
            v = parts[1].strip().strip('\"').strip(\"'\")
            current[k] = v
    elif in_sources and not line.strip().startswith('#') and not line.strip() == '' and not line.startswith(' '):
        break
if current:
    print(f\"  {current.get('name','?'):20s} {current.get('marketplace','?')}/{current.get('plugin','?')}\")
"
}

cmd_source_add() {
  local name="${1:-}" marketplace="${2:-}" plugin="${3:-}"
  [[ -z "$name" || -z "$marketplace" || -z "$plugin" ]] && \
    die "Usage: ai-env source add <name> <marketplace> <plugin>\n  Example: ai-env source add superpowers superpowers-dev superpowers"

  # Validate plugin cache exists
  local cache_path="$HOME/.claude/plugins/cache/${marketplace}/${plugin}"
  if [[ ! -d "$cache_path" ]]; then
    die "Plugin cache not found: ${cache_path}\n  Available marketplaces: $(ls ~/.claude/plugins/cache/ 2>/dev/null | tr '\n' ' ')"
  fi

  # Ensure sources file exists with header
  if [[ ! -f "$SOURCES_FILE" ]]; then
    mkdir -p "$(dirname "$SOURCES_FILE")"
    echo "sources:" > "$SOURCES_FILE"
  fi

  # Check for duplicate name
  if grep -q "name: ${name}" "$SOURCES_FILE" 2>/dev/null; then
    die "Source '${name}' already registered. Remove it first with: ai-env source remove ${name}"
  fi

  # Append
  cat >> "$SOURCES_FILE" << EOF
  - name: "${name}"
    marketplace: "${marketplace}"
    plugin: "${plugin}"
EOF

  success "Registered source: ${BOLD}${name}${RESET} (${marketplace}/${plugin})"
}

cmd_source_remove() {
  local name="${1:-}"
  [[ -z "$name" ]] && die "Usage: ai-env source remove <name>"

  if ! grep -q "name: .*${name}" "$SOURCES_FILE" 2>/dev/null; then
    die "Source '${name}' not found."
  fi

  # Use python to remove the block
  python3 -c "
import re
with open('$SOURCES_FILE') as f:
    content = f.read()

# Remove the block starting with '  - name: \"$name\"' until next '  - ' or end of sources
lines = content.split('\n')
result = []
skip = False
for line in lines:
    if '  - name:' in line and '$name' in line:
        skip = True
        continue
    if skip and (line.startswith('  - ') or (line and not line.startswith('    ') and not line.startswith('  - '))):
        skip = False
    if skip and line.startswith('    '):
        continue
    result.append(line)

with open('$SOURCES_FILE', 'w') as f:
    f.write('\n'.join(result))
"
  success "Removed source: ${BOLD}${name}${RESET}"
}

# ---------------------------------------------------------------------------
# Git Repo Management
# ---------------------------------------------------------------------------

# parse_repos - reads repos: section from sources.yaml
# Outputs: name|url|skills_path|prefix lines
parse_repos() {
  [[ ! -f "$SOURCES_FILE" ]] && return
  python3 -c "
in_repos = False
current = {}
for line in open('$SOURCES_FILE'):
    line = line.rstrip()
    if line.startswith('repos:'):
        in_repos = True
        continue
    if not in_repos:
        continue
    if line.startswith('  - '):
        if current.get('name'):
            print(f\"{current['name']}|{current.get('url','')}|{current.get('skills_path','skills')}|{current.get('prefix','')}\")
        current = {}
        rest = line[4:].strip()
        if rest.startswith('name:'):
            current['name'] = rest.split(':',1)[1].strip().strip('\"').strip(\"'\")
    elif line.startswith('    ') and ':' in line:
        k, v = line.strip().split(':', 1)
        current[k.strip()] = v.strip().strip('\"').strip(\"'\")
    elif line and not line.startswith(' ') and not line.startswith('#'):
        break
if current.get('name'):
    print(f\"{current['name']}|{current.get('url','')}|{current.get('skills_path','skills')}|{current.get('prefix','')}\")
"
}

cmd_repo() {
  local subcmd="${1:-}"
  shift || true
  case "$subcmd" in
    list|ls)   cmd_repo_list "$@" ;;
    add)       cmd_repo_add "$@" ;;
    remove|rm) cmd_repo_remove "$@" ;;
    update)    cmd_repo_update "$@" ;;
    "")        die "Usage: ai-env repo <list|add|remove|update>" ;;
    *)         die "Unknown repo command: $subcmd" ;;
  esac
}

cmd_repo_list() {
  if [[ ! -f "$SOURCES_FILE" ]] || ! grep -q "^repos:" "$SOURCES_FILE" 2>/dev/null; then
    warn "No git repos registered. Add one with: ${CYAN}ai-env repo add <name> <url>${RESET}"
    return
  fi
  echo -e "${BOLD}Registered git repos:${RESET}\n"

  while IFS='|' read -r name url skills_path prefix; do
    local repo_dir="$REPOS_DIR/$name"
    prefix="${prefix:-}"
    local status="${DIM}(not cloned)${RESET}"
    if [[ -d "$repo_dir/.git" ]]; then
      local branch
      branch=$(git -C "$repo_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
      local short_hash
      short_hash=$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || echo "?")
      status="${GREEN}${branch}@${short_hash}${RESET}"
    fi
    echo -e "  ${BOLD}${name}${RESET}  ${status}"
    echo -e "    ${DIM}${url}${RESET}"
    local prefix_display="none"
    if [[ -n "$prefix" && "$prefix" != "false" ]]; then
      [[ "$prefix" == "true" ]] && prefix_display="${name}-*" || prefix_display="${prefix}-*"
    fi
    echo -e "    ${DIM}skills_path: ${skills_path}, prefix: ${prefix_display}${RESET}"
    echo ""
  done < <(parse_repos)
}

cmd_repo_add() {
  local name="${1:-}" url="${2:-}" skills_path="${3:-skills}"
  [[ -z "$name" || -z "$url" ]] && \
    die "Usage: ai-env repo add <name> <url> [skills_path]\n  Example: ai-env repo add lenny https://github.com/RefoundAI/lenny-skills skills"

  # Ensure sources file exists with header
  if [[ ! -f "$SOURCES_FILE" ]]; then
    mkdir -p "$(dirname "$SOURCES_FILE")"
    echo "sources:" > "$SOURCES_FILE"
  fi

  # Check for duplicate name
  if grep -q "repos:" "$SOURCES_FILE" 2>/dev/null && \
     python3 -c "
found = False
in_repos = False
for line in open('$SOURCES_FILE'):
    line = line.rstrip()
    if line.startswith('repos:'):
        in_repos = True
        continue
    if in_repos and 'name:' in line and '$name' in line:
        found = True
        break
print('yes' if found else 'no')
" 2>/dev/null | grep -q "yes"; then
    die "Repo '${name}' already registered. Remove it first with: ai-env repo remove ${name}"
  fi

  # Append repos section if needed
  if ! grep -q "^repos:" "$SOURCES_FILE" 2>/dev/null; then
    echo "" >> "$SOURCES_FILE"
    echo "repos:" >> "$SOURCES_FILE"
  fi

  cat >> "$SOURCES_FILE" << EOF
  - name: "${name}"
    url: "${url}"
    skills_path: "${skills_path}"
EOF

  # Clone the repo
  mkdir -p "$REPOS_DIR"
  local repo_dir="$REPOS_DIR/$name"
  if [[ ! -d "$repo_dir" ]]; then
    info "Cloning ${url}..."
    if git clone --depth 1 "$url" "$repo_dir" 2>/dev/null; then
      local skill_count=0
      if [[ -d "$repo_dir/$skills_path" ]]; then
        skill_count=$(find "$repo_dir/$skills_path" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
      fi
      success "Cloned: ${BOLD}${name}${RESET} (${skill_count} skills found)"
    else
      warn "Clone failed. Run ${CYAN}ai-env repo update ${name}${RESET} to retry."
    fi
  fi

  success "Registered repo: ${BOLD}${name}${RESET}"
  info "Run ${CYAN}ai-env scan --force${RESET} to sync skills into the store."
}

cmd_repo_remove() {
  local name="${1:-}"
  [[ -z "$name" ]] && die "Usage: ai-env repo remove <name>"

  if ! grep -q "^repos:" "$SOURCES_FILE" 2>/dev/null; then
    die "No repos section found in sources.yaml"
  fi

  # Check if repo exists in config
  local found
  found=$(python3 -c "
in_repos = False
for line in open('$SOURCES_FILE'):
    line = line.rstrip()
    if line.startswith('repos:'):
        in_repos = True
        continue
    if in_repos and 'name:' in line and '$name' in line:
        print('yes')
        break
else:
    print('no')
" 2>/dev/null)

  [[ "$found" != "yes" ]] && die "Repo '${name}' not found."

  # Remove from config
  python3 -c "
lines = open('$SOURCES_FILE').read().split('\n')
result = []
skip = False
in_repos = False
for line in lines:
    if line.startswith('repos:'):
        in_repos = True
        result.append(line)
        continue
    if in_repos and '  - name:' in line and '$name' in line:
        skip = True
        continue
    if skip and (line.startswith('  - ') or (line and not line.startswith('    ') and not line.startswith('  - '))):
        skip = False
    if skip and line.startswith('    '):
        continue
    if not in_repos:
        result.append(line)
    else:
        result.append(line)
with open('$SOURCES_FILE', 'w') as f:
    f.write('\n'.join(result))
"

  # Remove symlinks from store that point into this repo
  local removed=0
  local repo_dir="$REPOS_DIR/$name"
  if [[ -d "$SKILL_STORE" ]]; then
    for item in "$SKILL_STORE"/*/; do
      [[ ! -L "${item%/}" ]] && continue
      local target
      target=$(readlink "${item%/}")
      if [[ "$target" == *"repos/${name}/"* ]]; then
        rm "${item%/}"
        (( removed++ )) || true
      fi
    done
  fi

  # Remove cloned repo
  if [[ -d "$repo_dir" ]]; then
    rm -rf "$repo_dir"
    info "Removed cloned repo: ${repo_dir}"
  fi

  success "Removed repo: ${BOLD}${name}${RESET} (${removed} skill symlinks cleaned)"
}

cmd_repo_update() {
  local target="${1:-}"

  if [[ ! -f "$SOURCES_FILE" ]] || ! grep -q "^repos:" "$SOURCES_FILE" 2>/dev/null; then
    die "No git repos registered."
  fi

  local updated=0
  while IFS='|' read -r name url skills_path prefix; do
    [[ -n "$target" && "$name" != "$target" ]] && continue

    local repo_dir="$REPOS_DIR/$name"

    if [[ ! -d "$repo_dir/.git" ]]; then
      info "Repo '${name}' not cloned yet. Cloning..."
      mkdir -p "$REPOS_DIR"
      if git clone --depth 1 "$url" "$repo_dir" 2>/dev/null; then
        success "Cloned: ${name}"
        (( updated++ )) || true
      else
        warn "Failed to clone: ${name}"
      fi
      continue
    fi

    local before_hash
    before_hash=$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null)

    info "Updating '${name}'..."
    if git -C "$repo_dir" pull --ff-only 2>/dev/null; then
      local after_hash
      after_hash=$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null)
      if [[ "$before_hash" != "$after_hash" ]]; then
        local commit_count
        commit_count=$(git -C "$repo_dir" rev-list "${before_hash}..${after_hash}" --count 2>/dev/null || echo "?")
        success "Updated: ${BOLD}${name}${RESET} (${commit_count} new commit(s))"
        (( updated++ )) || true
      else
        echo -e "  ${DIM}${name}: already up to date${RESET}"
      fi
    else
      warn "Update failed for '${name}'. Try: cd ${repo_dir} && git pull"
    fi
  done < <(parse_repos)

  if [[ -n "$target" ]] && [[ $updated -eq 0 ]]; then
    # Check if target was found at all
    local found=false
    while IFS='|' read -r name _ _; do
      [[ "$name" == "$target" ]] && found=true
    done < <(parse_repos)
    [[ "$found" == false ]] && die "Repo '${target}' not found."
  fi

  if [[ $updated -gt 0 ]]; then
    echo ""
    info "Run ${CYAN}ai-env scan --force${RESET} to sync updated skills into the store."
  fi
}

# ---------------------------------------------------------------------------
# Scan Command
# ---------------------------------------------------------------------------

cmd_scan() {
  local verbose=false
  local force=false
  for arg in "$@"; do
    case "$arg" in
      -v|--verbose) verbose=true ;;
      -f|--force) force=true ;;
    esac
  done

  [[ ! -d "$SKILL_STORE" ]] && mkdir -p "$SKILL_STORE"

  # Skip scan if nothing changed (unless forced)
  local scan_cache="$CONFIG_DIR/.last-scan"
  if [[ "$force" == false && -f "$scan_cache" ]]; then
    local cache_mtime now cache_age
    cache_mtime=$(stat -f %m "$scan_cache" 2>/dev/null || echo 0)
    now=$(date +%s)
    cache_age=$(( now - cache_mtime ))
    # Skip if last scan was less than 60 seconds ago
    if [[ "$cache_age" -lt 60 ]]; then
      [[ "$verbose" == true ]] && info "Scan cached (${cache_age}s ago, use --force to rescan)"
      return 0
    fi
  fi

  info "Scanning skill sources..."

  # 0a. Auto-detect unregistered plugin sources
  if [[ -d "$HOME/.claude/plugins/cache" ]]; then
    # Ensure sources file exists
    if [[ ! -f "$SOURCES_FILE" ]]; then
      mkdir -p "$(dirname "$SOURCES_FILE")"
      echo "sources:" > "$SOURCES_FILE"
    fi

    for marketplace_dir in "$HOME/.claude/plugins/cache"/*/; do
      [[ ! -d "$marketplace_dir" ]] && continue
      local marketplace
      marketplace=$(basename "$marketplace_dir")
      for plugin_dir in "$marketplace_dir"/*/; do
        [[ ! -d "$plugin_dir" ]] && continue
        local plugin
        plugin=$(basename "$plugin_dir")

        # Check if any version has skills
        local has_skills=false
        for version_dir in "$plugin_dir"/*/; do
          if [[ -d "${version_dir}skills" || -d "${version_dir}.claude/skills" ]]; then
            has_skills=true
            break
          fi
        done
        [[ "$has_skills" == false ]] && continue

        # Check if already registered
        if ! grep -q "marketplace: \"${marketplace}\"" "$SOURCES_FILE" 2>/dev/null || \
           ! grep -q "plugin: \"${plugin}\"" "$SOURCES_FILE" 2>/dev/null; then
          # Not registered — check more carefully with python
          local already_registered
          already_registered=$(python3 -c "
found = False
current = {}
in_sources = False
for line in open('$SOURCES_FILE'):
    line = line.rstrip()
    if line.startswith('sources:'):
        in_sources = True
        continue
    if not in_sources:
        continue
    if line.startswith('  - '):
        if current.get('marketplace') == '$marketplace' and current.get('plugin') == '$plugin':
            found = True
            break
        current = {}
    elif line.startswith('    ') and ':' in line:
        k, v = line.strip().split(':', 1)
        current[k.strip()] = v.strip().strip('\"').strip(\"'\")
if current.get('marketplace') == '$marketplace' and current.get('plugin') == '$plugin':
    found = True
print('yes' if found else 'no')
")
          if [[ "$already_registered" == "no" ]]; then
            local source_name="${plugin}"
            source_name="${source_name/itp-engineering-/itp-eng-}"
            # Insert into the sources: section (before repos: if it exists)
            python3 -c "
content = open('$SOURCES_FILE').read()
entry = '  - name: \"${source_name}\"\n    marketplace: \"${marketplace}\"\n    plugin: \"${plugin}\"\n'
if 'repos:' in content:
    # Insert before the repos: line
    content = content.replace('repos:', entry + 'repos:', 1)
else:
    # Append to end
    content = content.rstrip() + '\n' + entry
with open('$SOURCES_FILE', 'w') as f:
    f.write(content)
"
            info "Auto-registered new source: ${BOLD}${source_name}${RESET} (${marketplace}/${plugin})"
          fi
        fi
      done
    done
  fi

  # 0b. Disable enabled plugins in settings.json (ai-env manages skills)
  local settings_file="$HOME/.claude/settings.json"
  if [[ -f "$settings_file" ]]; then
    local disabled_count
    disabled_count=$(python3 -c "
import json
with open('$settings_file') as f:
    data = json.load(f)
plugins = data.get('enabledPlugins', {})
count = 0
for key in plugins:
    if plugins[key]:
        plugins[key] = False
        count += 1
if count > 0:
    with open('$settings_file', 'w') as f:
        json.dump(data, f, indent=2)
        f.write('\n')
print(count)
")
    if [[ "$disabled_count" -gt 0 ]]; then
      info "Disabled ${disabled_count} plugin(s) in settings.json (ai-env manages skills)"
    fi
  fi

  # 0c. Sweep new skills from agent dirs into store
  #     (catches skills installed by npx skills add -g)
  local swept=0
  for agent_dir in "$AGENT_SKILLS" "$CLAUDE_SKILLS"; do
    [[ ! -d "$agent_dir" ]] && continue
    for item in "$agent_dir"/*/; do
      [[ ! -d "$item" ]] && continue
      # Skip symlinks (managed by ai-env)
      [[ -L "${item%/}" ]] && continue
      local name
      name=$(basename "$item")
      local store_target="$SKILL_STORE/${name}"
      if [[ ! -d "$store_target" && ! -L "$store_target" ]]; then
        mv "${item%/}" "$store_target"
        [[ "$verbose" == true ]] && echo -e "  ${GREEN}+${RESET} swept: ${name} -> store"
        (( swept++ )) || true
      fi
    done
  done
  if [[ $swept -gt 0 ]]; then
    info "Swept ${swept} new skill(s) from agent dirs into store"
  fi

  # 0d. Remove broken symlinks from store
  local broken_removed=0
  for item in "$SKILL_STORE"/*/; do
    [[ ! -L "${item%/}" ]] && continue
    if [[ ! -e "${item%/}" ]]; then
      rm "${item%/}"
      [[ "$verbose" == true ]] && echo -e "  ${DIM}removed broken: $(basename "$item")${RESET}"
      (( broken_removed++ )) || true
    fi
  done
  if [[ $broken_removed -gt 0 ]]; then
    info "Removed ${broken_removed} broken symlink(s) from store"
  fi

  local total_synced=0
  local total_skipped=0
  local stale_sources=()
  local shadowed_skills=()

  # 1. Scan registered plugin sources
  if [[ -f "$SOURCES_FILE" ]]; then
    # Parse sources and scan each
    while IFS='|' read -r src_name src_marketplace src_plugin; do
      local cache_path="$HOME/.claude/plugins/cache/${src_marketplace}/${src_plugin}"

      if [[ ! -d "$cache_path" ]]; then
        warn "Source '${src_name}': plugin uninstalled, removing source"
        stale_sources+=("$src_name")
        continue
      fi

      local version_dir
      version_dir=$(resolve_latest_version "$cache_path") || {
        warn "Source '${src_name}': no versions found"
        continue
      }

      local src_count=0
      while IFS= read -r skill_path; do
        [[ -z "$skill_path" ]] && continue
        local skill_name
        skill_name=$(basename "$skill_path")
        local target="$SKILL_STORE/${skill_name}"

        if [[ -d "$target" && ! -L "$target" ]]; then
          # Local skill takes precedence -- don't overwrite
          [[ "$verbose" == true ]] && echo -e "  ${DIM}skip: ${skill_name} (local override)${RESET}"
          shadowed_skills+=("${skill_name}|${src_name}")
          (( total_skipped++ )) || true
        elif [[ -L "$target" ]]; then
          # Already a symlink -- update if pointing elsewhere
          local current_target
          current_target=$(readlink "$target")
          local new_target="${skill_path%/}"
          if [[ "$current_target" != "$new_target" ]]; then
            rm "$target"
            ln -s "$new_target" "$target"
            [[ "$verbose" == true ]] && echo -e "  ${DIM}update: ${skill_name} -> ${new_target}${RESET}"
          fi
          (( src_count++ )) || true
        else
          # New skill -- create symlink
          ln -s "${skill_path%/}" "$target"
          [[ "$verbose" == true ]] && echo -e "  ${GREEN}+${RESET} ${skill_name} -> ${skill_path%/}"
          (( src_count++ )) || true
        fi
      done < <(find_skills_in_version "$version_dir")

      (( total_synced += src_count )) || true
      info "Source '${src_name}': ${src_count} skills from ${version_dir##*/}"

    done < <(parse_sources)

    # Remove stale sources
    for stale in "${stale_sources[@]}"; do
      cmd_source_remove "$stale" > /dev/null 2>&1 || true
    done
  fi

  # 1b. Scan git repo sources
  local total_repo_synced=0
  local repo_updates_available=()

  if [[ -f "$SOURCES_FILE" ]] && grep -q "^repos:" "$SOURCES_FILE" 2>/dev/null; then
    while IFS='|' read -r repo_name repo_url repo_skills_path repo_prefix; do
      local repo_dir="$REPOS_DIR/$repo_name"
      repo_prefix="${repo_prefix:-false}"

      if [[ ! -d "$repo_dir/.git" ]]; then
        warn "Repo '${repo_name}': not cloned. Run ${CYAN}ai-env repo update ${repo_name}${RESET}"
        continue
      fi

      # Check for remote updates (fetch only, no working tree changes)
      if git -C "$repo_dir" fetch --dry-run 2>&1 | grep -q .; then
        local local_hash remote_hash
        local_hash=$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null)
        # Actually fetch so we can compare (fetch is safe — no working tree changes)
        git -C "$repo_dir" fetch --quiet 2>/dev/null || true
        local default_branch
        default_branch=$(git -C "$repo_dir" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||' || echo "main")
        remote_hash=$(git -C "$repo_dir" rev-parse "origin/${default_branch}" 2>/dev/null || echo "")
        if [[ -n "$remote_hash" && "$local_hash" != "$remote_hash" ]]; then
          local behind_count
          behind_count=$(git -C "$repo_dir" rev-list "HEAD..origin/${default_branch}" --count 2>/dev/null || echo "?")
          repo_updates_available+=("${repo_name}|${behind_count}")
        fi
      fi

      # Sync skills from repo into store
      local repo_skill_dir="$repo_dir/$repo_skills_path"
      if [[ ! -d "$repo_skill_dir" ]]; then
        warn "Repo '${repo_name}': skills_path '${repo_skills_path}' not found"
        continue
      fi

      local repo_count=0
      for skill_dir in "$repo_skill_dir"/*/; do
        [[ ! -d "$skill_dir" ]] && continue
        local skill_name
        skill_name=$(basename "$skill_dir")

        # Apply custom prefix if set (non-empty and not "false")
        local original_name="$skill_name"
        if [[ -n "$repo_prefix" && "$repo_prefix" != "false" && "$repo_prefix" != "true" ]]; then
          # Use custom prefix value
          if [[ ! "$skill_name" == "${repo_prefix}-"* ]]; then
            skill_name="${repo_prefix}-${skill_name}"
          fi
        elif [[ "$repo_prefix" == "true" ]]; then
          # Use repo name as prefix
          if [[ ! "$skill_name" == "${repo_name}-"* ]]; then
            skill_name="${repo_name}-${skill_name}"
          fi
        fi

        # Clean up stale unprefixed symlink if prefix was applied
        if [[ "$skill_name" != "$original_name" ]]; then
          local stale="$SKILL_STORE/${original_name}"
          if [[ -L "$stale" ]] && [[ "$(readlink "$stale")" == *"repos/${repo_name}/"* ]]; then
            rm "$stale"
            [[ "$verbose" == true ]] && echo -e "  ${DIM}clean: removed unprefixed ${original_name} (now ${skill_name})${RESET}"
          fi
        fi

        local target="$SKILL_STORE/${skill_name}"

        if [[ -d "$target" && ! -L "$target" ]]; then
          # Local skill takes precedence
          [[ "$verbose" == true ]] && echo -e "  ${DIM}skip: ${skill_name} (local override)${RESET}"
          shadowed_skills+=("${skill_name}|${repo_name}")
          (( total_skipped++ )) || true
        elif [[ -L "$target" ]]; then
          # Already a symlink -- update if pointing elsewhere
          local current_target
          current_target=$(readlink "$target")
          local new_target="${skill_dir%/}"
          if [[ "$current_target" != "$new_target" ]]; then
            rm "$target"
            ln -s "$new_target" "$target"
            [[ "$verbose" == true ]] && echo -e "  ${DIM}update: ${skill_name} -> ${new_target}${RESET}"
          fi
          (( repo_count++ )) || true
        else
          # New skill -- create symlink
          ln -s "${skill_dir%/}" "$target"
          [[ "$verbose" == true ]] && echo -e "  ${GREEN}+${RESET} ${skill_name} -> ${skill_dir%/}"
          (( repo_count++ )) || true
        fi
      done

      (( total_repo_synced += repo_count )) || true
      info "Repo '${repo_name}': ${repo_count} skills from ${repo_skills_path}/"

    done < <(parse_repos)
  fi

  # 2. Count local skills (direct dirs in canonical store, not symlinks)
  local local_count=0
  for item in "$SKILL_STORE"/*/; do
    [[ -d "$item" && ! -L "$item" ]] && (( local_count++ )) || true
  done

  # 3. Count total
  local total=0
  for item in "$SKILL_STORE"/*/; do
    [[ -d "$item" ]] && (( total++ )) || true
  done

  local from_synced=$(( total_synced + total_repo_synced ))

  echo ""
  # Update scan cache
  touch "$scan_cache"

  success "Scan complete: ${BOLD}${total}${RESET} skills in canonical store (${local_count} local, ${total_synced} from plugins, ${total_repo_synced} from repos)"

  # Report available repo updates
  if [[ ${#repo_updates_available[@]} -gt 0 ]]; then
    echo ""
    info "Repo updates available:"
    for entry in "${repo_updates_available[@]}"; do
      local r_name="${entry%%|*}"
      local r_behind="${entry##*|}"
      echo -e "  ${YELLOW}•${RESET} ${BOLD}${r_name}${RESET}: ${r_behind} commit(s) behind"
    done
    echo -e "  ${DIM}Run ${CYAN}ai-env repo update${RESET}${DIM} to pull changes${RESET}"
  fi

  # 3b. Warn about local skills that shadow plugin versions
  if [[ ${#shadowed_skills[@]} -gt 0 ]]; then
    echo ""
    warn "Local skills shadowing plugin versions:"
    for entry in "${shadowed_skills[@]}"; do
      local s_name="${entry%%|*}"
      local s_source="${entry##*|}"
      echo -e "  ${YELLOW}•${RESET} ${BOLD}${s_name}${RESET} shadows plugin '${s_source}'"
    done
    echo -e "  ${DIM}To use the plugin version, remove the local copy:${RESET}"
    echo -e "  ${DIM}  rm -rf ${SKILL_STORE}/<skill-name> && ai-env scan --force${RESET}"
  fi

  # 4. Check environment configs for orphaned skill patterns
  if [[ -d "$ENV_DIR" ]]; then
    local has_warnings=false
    for env_file in "$ENV_DIR"/*.yaml; do
      [[ ! -f "$env_file" ]] && continue
      local env_name
      env_name=$(basename "$env_file" .yaml)

      # Get patterns and check each one
      local in_skills=false
      while IFS= read -r line; do
        line="${line%%#*}"  # strip comments
        if [[ "$line" =~ ^skills: ]]; then
          in_skills=true
          continue
        fi
        if [[ "$in_skills" == true && "$line" =~ ^[[:space:]]*-[[:space:]]*(.*) ]]; then
          local pattern="${BASH_REMATCH[1]}"
          pattern="${pattern//\"/}"
          pattern="${pattern//\'/}"
          pattern="${pattern## }"
          pattern="${pattern%% }"
          [[ -z "$pattern" ]] && continue

          # Check if pattern matches any skill
          local match_count
          match_count=$(python3 -c "
$PY_PREFIX_HELPER
import fnmatch
store = Path(os.path.expanduser('$SKILL_STORE'))
source_map, repo_map = _build_maps(os.path.expanduser('$SOURCES_FILE'))
count = 0
for item in store.iterdir():
    if not item.is_dir(): continue
    prefix, _ = _get_prefix(item, source_map, repo_map)
    sid = f'{prefix}:{item.name}'
    if fnmatch.fnmatch(sid, '$pattern'): count += 1
print(count)
" 2>/dev/null || echo 0)

          if [[ "$match_count" -eq 0 ]]; then
            if [[ "$has_warnings" == false ]]; then
              echo ""
              has_warnings=true
            fi
            warn "Environment ${BOLD}${env_name}${RESET}: pattern ${CYAN}\"${pattern}\"${RESET} matches 0 skills — source may have been removed"
          fi
        elif [[ "$in_skills" == true && "$line" =~ ^[^[:space:]] ]]; then
          in_skills=false
        fi
      done < "$env_file"
    done
  fi
}

# ---------------------------------------------------------------------------
# Skill ID Derivation
# ---------------------------------------------------------------------------

# derive_skill_ids <dirnames...>
# Resolves skill prefixes from symlink targets against registered sources.
# Symlinks: prefix = source name from sources.yaml
# Local dirs: prefix = "local"
# Accepts newline-separated dirnames on stdin, outputs prefix:dirname lines.
derive_skill_ids() {
  python3 -c "
$PY_PREFIX_HELPER
import sys
store = Path(os.path.expanduser('$SKILL_STORE'))
source_map, repo_map = _build_maps(os.path.expanduser('$SOURCES_FILE'))

for dirname in sys.stdin:
    dirname = dirname.strip()
    if not dirname:
        continue
    item = store / dirname
    prefix, _ = _get_prefix(item, source_map, repo_map)
    print(f'{prefix}:{dirname}')
"
}

# ---------------------------------------------------------------------------
# Inventory Command
# ---------------------------------------------------------------------------

cmd_inventory() {
  local filter="${1:-}"

  if [[ ! -d "$SKILL_STORE" ]]; then
    die "Canonical store not found. Run ${CYAN}ai-env init${RESET} first."
  fi

  echo -e "${BOLD}Skill Inventory${RESET} (${DIM}${SKILL_STORE}${RESET})\n"

  # Build inventory using python for clean sorting/grouping
  python3 -c "
$PY_PREFIX_HELPER
from collections import defaultdict

store = Path(os.path.expanduser('$SKILL_STORE'))
source_map, repo_map = _build_maps(os.path.expanduser('$SOURCES_FILE'))

def get_source_type(item):
    if not item.is_symlink():
        return 'local'
    target = str(item.resolve())
    for pk in repo_map:
        if pk in target:
            return 'repo'
    return 'plugin'

skills = []
for item in sorted(store.iterdir()):
    if not item.is_dir():
        continue
    prefix, remainder = _get_prefix(item, source_map, repo_map)
    skills.append((prefix, remainder, item.name, get_source_type(item)))

groups = defaultdict(list)
for prefix, remainder, dirname, stype in skills:
    groups[prefix].append((remainder, dirname, stype))

filter_pattern = '$filter'

for prefix in sorted(groups.keys()):
    items = groups[prefix]
    print(f'  \033[1m{prefix}\033[0m ({len(items)} skills)')
    for remainder, dirname, stype in items:
        skill_id = f'{prefix}:{remainder}'
        if filter_pattern and filter_pattern not in skill_id:
            continue
        if stype == 'plugin':
            marker = '  \033[2m(plugin)\033[0m'
        elif stype == 'repo':
            marker = '  \033[2m(repo)\033[0m'
        else:
            marker = ''
        print(f'    {skill_id}{marker}')
    print()

total = len(skills)
print(f'Total: {total} skills')
"
}

