#!/usr/bin/env bash
# ============================================================================
# ai-env — Skill Profile Manager for AI Coding Agents
# ============================================================================
# Discovers skills from multiple plugin sources, manages a local store
# at ~/.config/ai-env/skills/, and rebuilds agent skill directories with
# filtered symlinks based on environment configs.
#
# Usage:  ai-env <command> [options]
# Config: ~/.config/ai-env/
# ============================================================================

set -euo pipefail

# ---------------------------------------------------------------------------
# Constants & defaults
# ---------------------------------------------------------------------------
VERSION="2.0.0"
CONFIG_DIR="${AI_ENV_DIR:-$HOME/.config/ai-env}"
ENV_DIR="$CONFIG_DIR/environments"
SOURCES_FILE="$CONFIG_DIR/sources.yaml"
ACTIVE_FILE="$CONFIG_DIR/.active"
SKILL_STORE="$CONFIG_DIR/skills"
AGENT_SKILLS="$HOME/.agents/skills"
CLAUDE_SKILLS="$HOME/.claude/skills"
EDITOR="${EDITOR:-vim}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
info()    { echo -e "${BLUE}ℹ${RESET}  $*"; }
success() { echo -e "${GREEN}✓${RESET}  $*"; }
warn()    { echo -e "${YELLOW}⚠${RESET}  $*"; }
error()   { echo -e "${RED}✗${RESET}  $*" >&2; }
die()     { error "$@"; exit 1; }

# Check for required dependencies
require_cmd() {
  command -v "$1" &>/dev/null || die "Required command '$1' not found. Please install it."
}

# Read a YAML value using basic parsing (no external deps)
# Supports simple key: value pairs and nested keys via dot notation
yaml_get() {
  local file="$1" key="$2"
  # Handle simple top-level keys
  if [[ "$key" != *.* ]]; then
    grep -E "^${key}:" "$file" 2>/dev/null | head -1 | sed "s/^${key}:[[:space:]]*//" | sed 's/^["'"'"']\(.*\)["'"'"']$/\1/' | sed 's/[[:space:]]*$//' || true
  else
    # Handle nested keys (one level: parent.child)
    local parent="${key%%.*}"
    local child="${key#*.}"
    awk -v parent="$parent" -v child="$child" '
      BEGIN { in_section=0 }
      /^[^ #]/ { in_section=0 }
      $0 ~ "^"parent":" { in_section=1; next }
      in_section && $0 ~ "^[[:space:]]+"child":" {
        sub(/^[[:space:]]+/,"",$0)
        sub(/^[^:]+:[[:space:]]*/,"",$0)
        gsub(/^["'"'"'"'"'"']|["'"'"'"'"'"']$/,"",$0)
        print $0
        exit
      }
    ' "$file"
  fi
}

# Read a YAML list (lines starting with "  - ")
yaml_list() {
  local file="$1" key="$2"
  awk -v key="$key" '
    BEGIN { in_section=0 }
    /^[^ #]/ { if (in_section) exit; in_section=0 }
    $0 ~ "^"key":" { in_section=1; next }
    in_section && /^[[:space:]]+-[[:space:]]/ {
      sub(/^[[:space:]]+-[[:space:]]*/,"",$0)
      gsub(/^["'"'"'"'"'"']|["'"'"'"'"'"']$/,"",$0)
      gsub(/[[:space:]]*$/,"",$0)
      print $0
    }
  ' "$file"
}

# Read a YAML map (key: value pairs under a section)
yaml_map() {
  local file="$1" section="$2"
  awk -v section="$section" '
    BEGIN { in_section=0 }
    /^[^ #]/ { if (in_section) exit; in_section=0 }
    $0 ~ "^"section":" { in_section=1; next }
    in_section && /^[[:space:]]+[^-]/ && /:[[:space:]]/ {
      sub(/^[[:space:]]+/,"",$0)
      print $0
    }
  ' "$file"
}

# Read a deeply nested YAML value (up to 3 levels: a.b.c)
yaml_nested_get() {
  local file="$1" key="$2"
  local -a parts
  IFS='.' read -ra parts <<< "$key"
  local depth=${#parts[@]}

  if [[ $depth -eq 1 ]]; then
    yaml_get "$file" "${parts[0]}"
  elif [[ $depth -eq 2 ]]; then
    yaml_get "$file" "${parts[0]}.${parts[1]}"
  elif [[ $depth -eq 3 ]]; then
    # Three-level nesting: agents.claude.model
    python3 -c "
import sys
lines = open('$file').readlines()
level = 0
found = [False, False, False]
keys = ('${parts[0]}', '${parts[1]}', '${parts[2]}')
for line in lines:
    stripped = line.rstrip()
    if not stripped or stripped.startswith('#'):
        continue
    indent = len(line) - len(line.lstrip())
    content = stripped.lstrip()
    if indent == 0 and content.startswith(keys[0] + ':'):
        found[0] = True
        continue
    if found[0] and indent == 2 and content.startswith(keys[1] + ':'):
        found[1] = True
        continue
    if found[1] and indent == 4 and content.startswith(keys[2] + ':'):
        val = content.split(':', 1)[1].strip().strip('\"').strip(\"'\")
        print(val)
        sys.exit(0)
    if found[1] and indent <= 2:
        break
    if found[0] and indent == 0:
        break
"
  fi
}

env_file() {
  echo "$ENV_DIR/${1}.yaml"
}

env_exists() {
  [[ -f "$(env_file "$1")" ]]
}

list_envs() {
  find "$ENV_DIR" -maxdepth 1 -name '*.yaml' -exec basename {} .yaml \; 2>/dev/null | sort
}

get_active() {
  [[ -f "$ACTIVE_FILE" ]] && cat "$ACTIVE_FILE" || echo ""
}

# ---------------------------------------------------------------------------
# Plugin Version Resolution
# ---------------------------------------------------------------------------

# resolve_latest_version <cache_path>
# Prints the path to the latest version directory
resolve_latest_version() {
  local cache_path="$1"
  [[ ! -d "$cache_path" ]] && return 1

  python3 -c "
import os, re, sys
from pathlib import Path

cache = Path('$cache_path')
versions = [d for d in cache.iterdir() if d.is_dir()]
if not versions:
    sys.exit(1)

# Check if versions look like semver
semver_re = re.compile(r'^\d+\.\d+\.\d+$')
semver_versions = [v for v in versions if semver_re.match(v.name)]

if semver_versions:
    # Sort by semver (major, minor, patch)
    def semver_key(v):
        parts = v.name.split('.')
        return tuple(int(p) for p in parts)
    latest = max(semver_versions, key=semver_key)
else:
    # Hash-based: use modification time
    latest = max(versions, key=lambda v: v.stat().st_mtime)

print(latest)
"
}

# find_skills_in_version <version_dir>
# Prints skill directory paths, one per line
find_skills_in_version() {
  local version_dir="$1"

  # Check skills/ first (primary location)
  if [[ -d "${version_dir}/skills" ]]; then
    for skill_dir in "${version_dir}/skills"/*/; do
      [[ -d "$skill_dir" ]] && echo "$skill_dir"
    done
  fi

  # Also check .claude/skills/ (some plugins put skills here)
  if [[ -d "${version_dir}/.claude/skills" ]]; then
    for skill_dir in "${version_dir}/.claude/skills"/*/; do
      [[ -d "$skill_dir" ]] && echo "$skill_dir"
    done
  fi
}

# ---------------------------------------------------------------------------
# Source Management
# ---------------------------------------------------------------------------

# parse_sources - reads sources.yaml and outputs name|marketplace|plugin lines
parse_sources() {
  [[ ! -f "$SOURCES_FILE" ]] && return
  python3 -c "
in_sources = False
current = {}
for line in open('$SOURCES_FILE'):
    line = line.rstrip()
    if line.startswith('sources:'):
        in_sources = True
        continue
    if not in_sources:
        continue
    if line.startswith('  - '):
        if current.get('name'):
            print(f\"{current['name']}|{current.get('marketplace','')}|{current.get('plugin','')}\")
        current = {}
        rest = line[4:].strip()
        if rest.startswith('name:'):
            current['name'] = rest.split(':',1)[1].strip().strip('\"').strip(\"'\")
    elif line.startswith('    ') and ':' in line:
        k, v = line.strip().split(':', 1)
        current[k.strip()] = v.strip().strip('\"').strip(\"'\")
    elif line and not line.startswith(' ') and not line.startswith('#'):
        break
if current.get('name'):
    print(f\"{current['name']}|{current.get('marketplace','')}|{current.get('plugin','')}\")
"
}

cmd_source() {
  local subcmd="${1:-}"
  shift || true
  case "$subcmd" in
    list|ls)   cmd_source_list "$@" ;;
    add)       cmd_source_add "$@" ;;
    remove|rm) cmd_source_remove "$@" ;;
    "")        die "Usage: ai-env source <list|add|remove>" ;;
    *)         die "Unknown source command: $subcmd" ;;
  esac
}

cmd_source_list() {
  if [[ ! -f "$SOURCES_FILE" ]]; then
    warn "No sources registered. Run ${CYAN}ai-env init${RESET} or ${CYAN}ai-env source add${RESET}."
    return
  fi
  echo -e "${BOLD}Registered plugin sources:${RESET}\n"
  echo -e "  ${DIM}(~/.config/ai-env/skills/ is always scanned implicitly)${RESET}\n"

  # Parse sources from YAML
  python3 -c "
import sys
in_sources = False
current = {}
for line in open('$SOURCES_FILE'):
    line = line.rstrip()
    if line.startswith('sources:'):
        in_sources = True
        continue
    if in_sources and line.startswith('  - '):
        if current:
            print(f\"  {current.get('name','?'):20s} {current.get('marketplace','?')}/{current.get('plugin','?')}\")
        current = {}
        rest = line[4:].strip()
        if rest.startswith('name:'):
            current['name'] = rest.split(':',1)[1].strip().strip('\"').strip(\"'\")
    elif in_sources and line.startswith('    '):
        parts = line.strip().split(':', 1)
        if len(parts) == 2:
            k = parts[0].strip()
            v = parts[1].strip().strip('\"').strip(\"'\")
            current[k] = v
    elif in_sources and not line.strip().startswith('#') and not line.strip() == '' and not line.startswith(' '):
        break
if current:
    print(f\"  {current.get('name','?'):20s} {current.get('marketplace','?')}/{current.get('plugin','?')}\")
"
}

cmd_source_add() {
  local name="${1:-}" marketplace="${2:-}" plugin="${3:-}"
  [[ -z "$name" || -z "$marketplace" || -z "$plugin" ]] && \
    die "Usage: ai-env source add <name> <marketplace> <plugin>\n  Example: ai-env source add superpowers superpowers-dev superpowers"

  # Validate plugin cache exists
  local cache_path="$HOME/.claude/plugins/cache/${marketplace}/${plugin}"
  if [[ ! -d "$cache_path" ]]; then
    die "Plugin cache not found: ${cache_path}\n  Available marketplaces: $(ls ~/.claude/plugins/cache/ 2>/dev/null | tr '\n' ' ')"
  fi

  # Ensure sources file exists with header
  if [[ ! -f "$SOURCES_FILE" ]]; then
    mkdir -p "$(dirname "$SOURCES_FILE")"
    echo "sources:" > "$SOURCES_FILE"
  fi

  # Check for duplicate name
  if grep -q "name: ${name}" "$SOURCES_FILE" 2>/dev/null; then
    die "Source '${name}' already registered. Remove it first with: ai-env source remove ${name}"
  fi

  # Append
  cat >> "$SOURCES_FILE" << EOF
  - name: "${name}"
    marketplace: "${marketplace}"
    plugin: "${plugin}"
EOF

  success "Registered source: ${BOLD}${name}${RESET} (${marketplace}/${plugin})"
}

cmd_source_remove() {
  local name="${1:-}"
  [[ -z "$name" ]] && die "Usage: ai-env source remove <name>"

  if ! grep -q "name: .*${name}" "$SOURCES_FILE" 2>/dev/null; then
    die "Source '${name}' not found."
  fi

  # Use python to remove the block
  python3 -c "
import re
with open('$SOURCES_FILE') as f:
    content = f.read()

# Remove the block starting with '  - name: \"$name\"' until next '  - ' or end of sources
lines = content.split('\n')
result = []
skip = False
for line in lines:
    if '  - name:' in line and '$name' in line:
        skip = True
        continue
    if skip and (line.startswith('  - ') or (line and not line.startswith('    ') and not line.startswith('  - '))):
        skip = False
    if skip and line.startswith('    '):
        continue
    result.append(line)

with open('$SOURCES_FILE', 'w') as f:
    f.write('\n'.join(result))
"
  success "Removed source: ${BOLD}${name}${RESET}"
}

# ---------------------------------------------------------------------------
# Scan Command
# ---------------------------------------------------------------------------

cmd_scan() {
  local verbose=false
  local force=false
  for arg in "$@"; do
    case "$arg" in
      -v|--verbose) verbose=true ;;
      -f|--force) force=true ;;
    esac
  done

  [[ ! -d "$SKILL_STORE" ]] && mkdir -p "$SKILL_STORE"

  # Skip scan if nothing changed (unless forced)
  local scan_cache="$CONFIG_DIR/.last-scan"
  if [[ "$force" == false && -f "$scan_cache" ]]; then
    local cache_mtime now cache_age
    cache_mtime=$(stat -f %m "$scan_cache" 2>/dev/null || echo 0)
    now=$(date +%s)
    cache_age=$(( now - cache_mtime ))
    # Skip if last scan was less than 60 seconds ago
    if [[ "$cache_age" -lt 60 ]]; then
      [[ "$verbose" == true ]] && info "Scan cached (${cache_age}s ago, use --force to rescan)"
      return 0
    fi
  fi

  info "Scanning skill sources..."

  # 0a. Auto-detect unregistered plugin sources
  if [[ -d "$HOME/.claude/plugins/cache" ]]; then
    # Ensure sources file exists
    if [[ ! -f "$SOURCES_FILE" ]]; then
      mkdir -p "$(dirname "$SOURCES_FILE")"
      echo "sources:" > "$SOURCES_FILE"
    fi

    for marketplace_dir in "$HOME/.claude/plugins/cache"/*/; do
      [[ ! -d "$marketplace_dir" ]] && continue
      local marketplace
      marketplace=$(basename "$marketplace_dir")
      for plugin_dir in "$marketplace_dir"/*/; do
        [[ ! -d "$plugin_dir" ]] && continue
        local plugin
        plugin=$(basename "$plugin_dir")

        # Check if any version has skills
        local has_skills=false
        for version_dir in "$plugin_dir"/*/; do
          if [[ -d "${version_dir}skills" || -d "${version_dir}.claude/skills" ]]; then
            has_skills=true
            break
          fi
        done
        [[ "$has_skills" == false ]] && continue

        # Check if already registered
        if ! grep -q "marketplace: \"${marketplace}\"" "$SOURCES_FILE" 2>/dev/null || \
           ! grep -q "plugin: \"${plugin}\"" "$SOURCES_FILE" 2>/dev/null; then
          # Not registered — check more carefully with python
          local already_registered
          already_registered=$(python3 -c "
found = False
current = {}
in_sources = False
for line in open('$SOURCES_FILE'):
    line = line.rstrip()
    if line.startswith('sources:'):
        in_sources = True
        continue
    if not in_sources:
        continue
    if line.startswith('  - '):
        if current.get('marketplace') == '$marketplace' and current.get('plugin') == '$plugin':
            found = True
            break
        current = {}
    elif line.startswith('    ') and ':' in line:
        k, v = line.strip().split(':', 1)
        current[k.strip()] = v.strip().strip('\"').strip(\"'\")
if current.get('marketplace') == '$marketplace' and current.get('plugin') == '$plugin':
    found = True
print('yes' if found else 'no')
")
          if [[ "$already_registered" == "no" ]]; then
            local source_name="${plugin}"
            source_name="${source_name/itp-engineering-/itp-eng-}"
            cat >> "$SOURCES_FILE" << EOF
  - name: "${source_name}"
    marketplace: "${marketplace}"
    plugin: "${plugin}"
EOF
            info "Auto-registered new source: ${BOLD}${source_name}${RESET} (${marketplace}/${plugin})"
          fi
        fi
      done
    done
  fi

  # 0b. Disable enabled plugins in settings.json (ai-env manages skills)
  local settings_file="$HOME/.claude/settings.json"
  if [[ -f "$settings_file" ]]; then
    local disabled_count
    disabled_count=$(python3 -c "
import json
with open('$settings_file') as f:
    data = json.load(f)
plugins = data.get('enabledPlugins', {})
count = 0
for key in plugins:
    if plugins[key]:
        plugins[key] = False
        count += 1
if count > 0:
    with open('$settings_file', 'w') as f:
        json.dump(data, f, indent=2)
        f.write('\n')
print(count)
")
    if [[ "$disabled_count" -gt 0 ]]; then
      info "Disabled ${disabled_count} plugin(s) in settings.json (ai-env manages skills)"
    fi
  fi

  # 0c. Sweep new skills from agent dirs into store
  #     (catches skills installed by npx skills add -g)
  local swept=0
  for agent_dir in "$AGENT_SKILLS" "$CLAUDE_SKILLS"; do
    [[ ! -d "$agent_dir" ]] && continue
    for item in "$agent_dir"/*/; do
      [[ ! -d "$item" ]] && continue
      # Skip symlinks (managed by ai-env)
      [[ -L "${item%/}" ]] && continue
      local name
      name=$(basename "$item")
      local store_target="$SKILL_STORE/${name}"
      if [[ ! -d "$store_target" && ! -L "$store_target" ]]; then
        mv "${item%/}" "$store_target"
        [[ "$verbose" == true ]] && echo -e "  ${GREEN}+${RESET} swept: ${name} -> store"
        (( swept++ )) || true
      fi
    done
  done
  if [[ $swept -gt 0 ]]; then
    info "Swept ${swept} new skill(s) from agent dirs into store"
  fi

  # 0d. Remove broken symlinks from store
  local broken_removed=0
  for item in "$SKILL_STORE"/*/; do
    [[ ! -L "${item%/}" ]] && continue
    if [[ ! -e "${item%/}" ]]; then
      rm "${item%/}"
      [[ "$verbose" == true ]] && echo -e "  ${DIM}removed broken: $(basename "$item")${RESET}"
      (( broken_removed++ )) || true
    fi
  done
  if [[ $broken_removed -gt 0 ]]; then
    info "Removed ${broken_removed} broken symlink(s) from store"
  fi

  local total_synced=0
  local total_skipped=0
  local stale_sources=()

  # 1. Scan registered plugin sources
  if [[ -f "$SOURCES_FILE" ]]; then
    # Parse sources and scan each
    while IFS='|' read -r src_name src_marketplace src_plugin; do
      local cache_path="$HOME/.claude/plugins/cache/${src_marketplace}/${src_plugin}"

      if [[ ! -d "$cache_path" ]]; then
        warn "Source '${src_name}': plugin uninstalled, removing source"
        stale_sources+=("$src_name")
        continue
      fi

      local version_dir
      version_dir=$(resolve_latest_version "$cache_path") || {
        warn "Source '${src_name}': no versions found"
        continue
      }

      local src_count=0
      while IFS= read -r skill_path; do
        [[ -z "$skill_path" ]] && continue
        local skill_name
        skill_name=$(basename "$skill_path")
        local target="$SKILL_STORE/${skill_name}"

        if [[ -d "$target" && ! -L "$target" ]]; then
          # Local skill takes precedence -- don't overwrite
          [[ "$verbose" == true ]] && echo -e "  ${DIM}skip: ${skill_name} (local override)${RESET}"
          (( total_skipped++ )) || true
        elif [[ -L "$target" ]]; then
          # Already a symlink -- update if pointing elsewhere
          local current_target
          current_target=$(readlink "$target")
          local new_target="${skill_path%/}"
          if [[ "$current_target" != "$new_target" ]]; then
            rm "$target"
            ln -s "$new_target" "$target"
            [[ "$verbose" == true ]] && echo -e "  ${DIM}update: ${skill_name} -> ${new_target}${RESET}"
          fi
          (( src_count++ )) || true
        else
          # New skill -- create symlink
          ln -s "${skill_path%/}" "$target"
          [[ "$verbose" == true ]] && echo -e "  ${GREEN}+${RESET} ${skill_name} -> ${skill_path%/}"
          (( src_count++ )) || true
        fi
      done < <(find_skills_in_version "$version_dir")

      (( total_synced += src_count )) || true
      info "Source '${src_name}': ${src_count} skills from ${version_dir##*/}"

    done < <(parse_sources)

    # Remove stale sources
    for stale in "${stale_sources[@]}"; do
      cmd_source_remove "$stale" > /dev/null 2>&1 || true
    done
  fi

  # 2. Count local skills (direct dirs in canonical store, not symlinks)
  local local_count=0
  for item in "$SKILL_STORE"/*/; do
    [[ -d "$item" && ! -L "$item" ]] && (( local_count++ )) || true
  done

  # 3. Count total
  local total=0
  for item in "$SKILL_STORE"/*/; do
    [[ -d "$item" ]] && (( total++ )) || true
  done

  echo ""
  # Update scan cache
  touch "$scan_cache"

  success "Scan complete: ${BOLD}${total}${RESET} skills in canonical store (${local_count} local, ${total_synced} from plugins)"

  # 4. Check environment configs for orphaned skill patterns
  if [[ -d "$ENV_DIR" ]]; then
    local has_warnings=false
    for env_file in "$ENV_DIR"/*.yaml; do
      [[ ! -f "$env_file" ]] && continue
      local env_name
      env_name=$(basename "$env_file" .yaml)

      # Get patterns and check each one
      local in_skills=false
      while IFS= read -r line; do
        line="${line%%#*}"  # strip comments
        if [[ "$line" =~ ^skills: ]]; then
          in_skills=true
          continue
        fi
        if [[ "$in_skills" == true && "$line" =~ ^[[:space:]]*-[[:space:]]*(.*) ]]; then
          local pattern="${BASH_REMATCH[1]}"
          pattern="${pattern//\"/}"
          pattern="${pattern//\'/}"
          pattern="${pattern## }"
          pattern="${pattern%% }"
          [[ -z "$pattern" ]] && continue

          # Check if pattern matches any skill
          local match_count
          match_count=$(python3 -c "
import os, fnmatch
from pathlib import Path

store = Path(os.path.expanduser('$SKILL_STORE'))
sources_file = os.path.expanduser('$SOURCES_FILE')

source_map = {}
if os.path.exists(sources_file):
    current = {}
    in_sources = False
    for line in open(sources_file):
        line = line.rstrip()
        if line.startswith('sources:'):
            in_sources = True
            continue
        if not in_sources: continue
        if line.startswith('  - '):
            if current.get('name') and current.get('marketplace') and current.get('plugin'):
                source_map[f\"{current['marketplace']}/{current['plugin']}\"] = current['name']
            current = {}
            rest = line[4:].strip()
            if rest.startswith('name:'): current['name'] = rest.split(':',1)[1].strip().strip('\"').strip(\"'\")
        elif line.startswith('    ') and ':' in line:
            k, v = line.strip().split(':', 1)
            current[k.strip()] = v.strip().strip('\"').strip(\"'\")
    if current.get('name') and current.get('marketplace') and current.get('plugin'):
        source_map[f\"{current['marketplace']}/{current['plugin']}\"] = current['name']

count = 0
for item in store.iterdir():
    if not item.is_dir(): continue
    if item.is_symlink():
        target = str(item.resolve())
        prefix = 'plugin'
        for pk, sn in source_map.items():
            if pk in target: prefix = sn; break
        sid = f'{prefix}:{item.name}'
    elif '-' in item.name:
        sid = f'{item.name.split(\"-\",1)[0]}:{item.name.split(\"-\",1)[1]}'
    else:
        sid = f'local:{item.name}'
    if fnmatch.fnmatch(sid, '$pattern'): count += 1
print(count)
" 2>/dev/null || echo 0)

          if [[ "$match_count" -eq 0 ]]; then
            if [[ "$has_warnings" == false ]]; then
              echo ""
              has_warnings=true
            fi
            warn "Environment ${BOLD}${env_name}${RESET}: pattern ${CYAN}\"${pattern}\"${RESET} matches 0 skills — source may have been removed"
          fi
        elif [[ "$in_skills" == true && "$line" =~ ^[^[:space:]] ]]; then
          in_skills=false
        fi
      done < "$env_file"
    done
  fi
}

# ---------------------------------------------------------------------------
# Skill ID Derivation
# ---------------------------------------------------------------------------

# derive_skill_id <dirname>
# For canonical store items: prefix = first segment before '-', name = rest
# No dash = local:<dirname>
derive_skill_id() {
  local dirname="$1"
  if [[ "$dirname" == *-* ]]; then
    local prefix="${dirname%%-*}"
    local name="${dirname#*-}"
    echo "${prefix}:${name}"
  else
    echo "local:${dirname}"
  fi
}

