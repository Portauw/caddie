cmd_activate() {
  local name=""
  local dry_run=false
  local agent=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run|-n) dry_run=true; shift ;;
      --agent|-a) agent="$2"; shift 2 ;;
      -*) die "Unknown flag: $1" ;;
      *)  name="$1"; shift ;;
    esac
  done

  [[ -z "$name" ]] && die "Usage: ai-env activate <name> [--agent <agent>] [--dry-run]"
  env_exists "$name" || die "Environment '${name}' not found. Run 'ai-env list' to see available environments."

  local file
  file="$(env_file "$name")"
  local display_name
  display_name=$(yaml_get "$file" "name")
  local directory
  directory=$(yaml_get "$file" "directory")
  [[ -n "$directory" ]] && directory="${directory/#\~/$HOME}"

  # Step 1: Scan sources (silent unless verbose)
  info "Scanning sources..."
  cmd_scan > /dev/null 2>&1 || true

  # Step 2: Resolve skills + count by prefix (single python call)
  local resolve_output
  resolve_output=$(python3 -c "
import os, fnmatch
from pathlib import Path
from collections import Counter

store = Path(os.path.expanduser('$SKILL_STORE'))
sources_file = os.path.expanduser('$SOURCES_FILE')
env_file = '$file'

# Build source mapping
source_map = {}
if os.path.exists(sources_file):
    current = {}
    in_sources = False
    for line in open(sources_file):
        line = line.rstrip()
        if line.startswith('sources:'):
            in_sources = True
            continue
        if not in_sources:
            continue
        if line.startswith('  - '):
            if current.get('name') and current.get('marketplace') and current.get('plugin'):
                source_map[f\"{current['marketplace']}/{current['plugin']}\"] = current['name']
            current = {}
            rest = line[4:].strip()
            if rest.startswith('name:'):
                current['name'] = rest.split(':',1)[1].strip().strip('\"').strip(\"'\")
        elif line.startswith('    ') and ':' in line:
            k, v = line.strip().split(':', 1)
            current[k.strip()] = v.strip().strip('\"').strip(\"'\")
    if current.get('name') and current.get('marketplace') and current.get('plugin'):
        source_map[f\"{current['marketplace']}/{current['plugin']}\"] = current['name']

def get_prefix(item):
    if item.is_symlink():
        target = str(item.resolve())
        for path_key, src_name in source_map.items():
            if path_key in target:
                return src_name, item.name
        return 'plugin', item.name
    else:
        name = item.name
        if '-' in name:
            return name.split('-', 1)[0], name.split('-', 1)[1]
        return 'local', name

# Read patterns
patterns = []
in_skills = False
for line in open(env_file):
    line = line.rstrip()
    if line.startswith('skills:'):
        in_skills = True
        continue
    if in_skills and line.startswith('  - '):
        patterns.append(line[4:].strip().strip('\"').strip(\"'\"))
    elif in_skills and line and not line.startswith(' ') and not line.startswith('#'):
        break

if not patterns:
    print('SUMMARY:')
    exit(0)

# Build skill map and match
skill_map = {}
prefix_map = {}
for item in sorted(store.iterdir()):
    if not item.is_dir():
        continue
    prefix, remainder = get_prefix(item)
    skill_id = f'{prefix}:{remainder}'
    skill_map[skill_id] = item.name
    prefix_map[item.name] = prefix

matched = set()
for pattern in patterns:
    for skill_id, dirname in skill_map.items():
        if fnmatch.fnmatch(skill_id, pattern):
            matched.add(dirname)

# Output matched skills
for dirname in sorted(matched):
    print(dirname)

# Output summary line (prefixed with SUMMARY:)
counts = Counter()
for dirname in matched:
    counts[prefix_map.get(dirname, 'unknown')] += 1
parts = [f'{p}: {c}' for p, c in sorted(counts.items())]
summary = ', '.join(parts)
print(f'SUMMARY:{summary}')
")

  # Parse output: skill lines + last line is SUMMARY:
  local matched_skills prefix_summary skill_count
  prefix_summary=$(echo "$resolve_output" | grep '^SUMMARY:' | sed 's/^SUMMARY://')
  matched_skills=$(echo "$resolve_output" | grep -v '^SUMMARY:')
  skill_count=$(echo "$matched_skills" | grep -c . || echo 0)

  if [[ "$dry_run" == true ]]; then
    echo -e "\n${YELLOW}Dry run — would activate:${RESET}\n"
    echo -e "  Environment: ${BOLD}${display_name:-$name}${RESET}"
    [[ -n "$directory" ]] && echo -e "  Directory:   ${directory}"
    echo -e "  Skills:      ${skill_count} (${prefix_summary})"
    [[ -n "$agent" ]] && echo -e "  Agent:       ${agent}"
    echo ""
    echo -e "  ${DIM}Would rebuild ~/.claude/skills/ with ${skill_count} symlinks${RESET}"
    [[ -n "$agent" ]] && echo -e "  ${DIM}Would launch: ${agent}${RESET}"
    echo ""
    echo -e "  Matched skills:"
    echo "$matched_skills" | while IFS= read -r s; do
      [[ -n "$s" ]] && echo -e "    ${s}"
    done
    return
  fi

  # Step 4: Rebuild agent skill directories (skip if unchanged)
  local linked=0
  local current_active
  current_active=$(get_active)

  # Check if we can skip rebuild (same env, symlinks already correct)
  local needs_rebuild=true
  if [[ "$current_active" == "$name" ]]; then
    # Quick check: count symlinks in claude dir matches skill count
    local existing_count=0
    for item in "$CLAUDE_SKILLS"/*; do
      [[ -L "$item" ]] && (( existing_count++ )) || true
    done
    [[ "$existing_count" -eq "$skill_count" ]] && needs_rebuild=false
  fi

  if [[ "$needs_rebuild" == true ]]; then
    for agent_dir in "$CLAUDE_SKILLS" "$AGENT_SKILLS"; do
      mkdir -p "$agent_dir"

      # Remove all existing symlinks
      for item in "$agent_dir"/*; do
        [[ -L "$item" ]] && rm "$item"
      done

      # Create new symlinks for matched skills
      while IFS= read -r skill_dir; do
        [[ -z "$skill_dir" ]] && continue
        local source_path="$SKILL_STORE/${skill_dir}"
        local target_path="$agent_dir/${skill_dir}"

        if [[ -d "$source_path" || -L "$source_path" ]]; then
          ln -s "$source_path" "$target_path"
          [[ "$agent_dir" == "$CLAUDE_SKILLS" ]] && (( linked++ )) || true
        else
          warn "Skill directory not found: ${source_path}"
        fi
      done <<< "$matched_skills"
    done
  else
    linked=$skill_count
  fi

  # Step 5: Write active marker
  echo "$name" > "$ACTIVE_FILE"

  # Step 6: Build agent command (if --agent specified)
  local agent_cmd=()
  local agent_display=""

  if [[ -n "$agent" ]]; then
    local agent_command
    agent_command=$(yaml_nested_get "$file" "agents.${agent}.command")
    agent_command="${agent_command:-$agent}"

    case "$agent" in
      claude)
        agent_cmd=("$agent_command")
        local model permission_mode
        model=$(yaml_nested_get "$file" "agents.claude.model")
        permission_mode=$(yaml_nested_get "$file" "agents.claude.permission_mode")
        [[ -n "$model" ]] && agent_cmd+=("--model" "$model")
        [[ -n "$permission_mode" ]] && agent_cmd+=("--permission-mode" "$permission_mode")
        agent_display="claude"
        [[ -n "$model" ]] && agent_display="${agent_display} (${model}"
        [[ -n "$permission_mode" ]] && agent_display="${agent_display}, ${permission_mode} mode"
        [[ -n "$model" || -n "$permission_mode" ]] && agent_display="${agent_display})"
        ;;
      opencode)
        agent_cmd=("$agent_command")
        local model
        model=$(yaml_nested_get "$file" "agents.opencode.model")
        [[ -n "$model" ]] && agent_cmd+=("--model" "$model")
        agent_display="opencode"
        [[ -n "$model" ]] && agent_display="${agent_display} (${model})"
        ;;
      *)
        # Generic agent — just use command + model if available
        agent_cmd=("$agent_command")
        local model
        model=$(yaml_nested_get "$file" "agents.${agent}.model")
        [[ -n "$model" ]] && agent_cmd+=("--model" "$model")
        agent_display="${agent}"
        [[ -n "$model" ]] && agent_display="${agent_display} (${model})"
        ;;
    esac
  fi

  # Step 7: Print summary
  echo ""
  echo -e "${GREEN}✓${RESET} ${BOLD}Activated: ${display_name:-$name}${RESET}"
  [[ -n "$directory" ]] && echo -e "  Directory: ${directory}"
  echo -e "  Skills: ${linked} active (${prefix_summary})"
  [[ -n "$agent_display" ]] && echo -e "  Agent: ${agent_display}"
  echo ""

  # Step 8: Launch agent or print hint
  if [[ ${#agent_cmd[@]} -gt 0 ]]; then
    if [[ -n "$directory" ]]; then
      echo -e "  ${DIM}Launching: ${agent_cmd[*]}${RESET}"
      echo -e "${DIM}────────────────────────────────────────────────────${RESET}"
      cd "$directory"
    fi
    exec "${agent_cmd[@]}"
  else
    if [[ -n "$directory" ]]; then
      echo -e "  ${DIM}cd ${directory} && claude${RESET}"
    else
      echo -e "  ${DIM}claude${RESET}"
    fi
    echo ""
  fi
}

