# ---------------------------------------------------------------------------

usage() {
  printf '%b\n' "$(cat << EOF
${BOLD}ai-env${RESET} v${VERSION} — Skill Profile Manager for AI Coding Agents

${BOLD}USAGE${RESET}
  ai-env <command> [arguments] [flags]

${BOLD}SETUP${RESET}
  ${CYAN}init${RESET}                        Initialize: migrate skills, detect sources, first scan
  ${CYAN}source${RESET} list                  Show registered plugin sources
  ${CYAN}source${RESET} add <name> <mkt> <p>  Register a plugin source
  ${CYAN}source${RESET} remove <name>         Unregister a plugin source

${BOLD}GIT REPOS${RESET}
  ${CYAN}repo${RESET} list                    Show registered git repos + status
  ${CYAN}repo${RESET} add <name> <url> [path] Register + clone a git skill repo
  ${CYAN}repo${RESET} remove <name>           Unregister repo + clean up symlinks
  ${CYAN}repo${RESET} update [name]           Pull latest changes (all or specific)

${BOLD}DISCOVERY${RESET}
  ${CYAN}scan${RESET}    [-v]                 Scan sources + repos, sync to skill store
  ${CYAN}inventory${RESET}                    List all skills with prefix grouping

${BOLD}ENVIRONMENTS${RESET}
  ${CYAN}create${RESET}  <name>               Create a new environment interactively
  ${CYAN}list${RESET}    (ls)                 List all environments
  ${CYAN}show${RESET}    <name>               Show config + resolved skills
  ${CYAN}edit${RESET}    <name>               Open environment config in \$EDITOR
  ${CYAN}activate${RESET} [name]              Resolve skills for cwd (or explicit env)
  ${CYAN}clone${RESET}   <src> <dest>         Clone an environment config
  ${CYAN}delete${RESET}  <name>               Delete an environment
  ${CYAN}which${RESET}                        Show currently active environment
  ${CYAN}reset${RESET}   [-f]                 Remove symlinks, store & re-enable plugins

${BOLD}EXPORT${RESET}
  ${CYAN}export${RESET}  <env> --to <dir>       Copy resolved skills to local directory
  ${CYAN}export${RESET}  <env> --to s3://b/p/   Upload resolved skills to S3
  ${CYAN}export${RESET}  --all --to <target>    Export all skills (no env filter)
  Flags: --clean (remove stale), --dry-run (preview)
  Env:   AWS_PROFILE, AWS_ENDPOINT_URL (for S3 targets)

${BOLD}FLAGS${RESET}
  -n, --dry-run             Show what would happen without executing
  -v, --verbose             Show detailed output
